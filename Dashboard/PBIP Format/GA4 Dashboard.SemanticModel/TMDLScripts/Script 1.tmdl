		table #_Measures_
			lineageTag: be05c863-c494-4a19-ada4-ccf8a1348cfa

			measure 'Total users' = DISTINCTCOUNT ( fact_events[user_key] )
				formatString: #,0
				displayFolder: User Acquisition\Base
				lineageTag: d9a6ab74-9a28-443e-a106-f613928e4bf9

			measure 'New users' =
					CALCULATE (
					    DISTINCTCOUNT ( fact_events[user_key] ),
					    fact_events[event_name] IN { "first_visit", "first_open" }
					)
				formatString: #,0
				displayFolder: User Acquisition\Base
				lineageTag: dfbe613b-78b7-4e28-9c9f-805381298a01

			measure Sessions = COUNTROWS ( fact_sessions )
				formatString: #,0
				displayFolder: User Acquisition\Base
