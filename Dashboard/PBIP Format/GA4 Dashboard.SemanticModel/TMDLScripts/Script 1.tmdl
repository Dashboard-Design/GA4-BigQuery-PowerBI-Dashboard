				formatString: #,0
				displayFolder: Period comparison\Previous period
				lineageTag: a9f90c4c-cb7d-45be-a1a9-51dfcc00b2f8

			measure 'ECVR (Comparison)' =
					VAR _start = [Comparison Start]
					VAR _end   = [Comparison End]
					RETURN
					    IF (
					        _start >= [First Data Date],
					        CALCULATE (
