createOrReplace

	ref table '#_Measures_'

		/// How many sources the Channel quality card shows (list and plot).
		measure 'Quality Top N' = 6
			formatString: 0
			displayFolder: HTML cards

		/// Below this many sessions a source gets the 'Low data' verdict instead of a judgement.
		measure 'Quality Min Sessions' = 100
			formatString: 0
			displayFolder: HTML cards

		/// Rank of the source in the row by sessions (1 = biggest). Used for the numbered markers and list.
		measure 'Quality Rank' = ```
				IF (
				    [Sessions] > 0,
				    RANKX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [Sessions], , DESC, DENSE )
				)
				```
			formatString: 0
			displayFolder: HTML cards

		/// Scale / Fix funnel / Hidden gem / Monitor / Low data. 'Big' = share of sessions >= equal share of the active sources; 'converts' = ECVR >= all-sources ECVR.
		measure 'Quality Verdict' = ```
				VAR _sessions = [Sessions]
				VAR _share    = [Sessions Share]
				VAR _ecvr     = COALESCE ( [ECVR], 0 )
				VAR _bench    = CALCULATE ( [ECVR], ALLSELECTED ( dim_traffic_source ) )
				VAR _active   = COUNTROWS ( FILTER ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [Sessions] > 0 ) )
				VAR _isBig    = _share >= DIVIDE ( 1, _active )
				VAR _converts = _ecvr >= _bench
				RETURN
				    IF (
				        ISBLANK ( _sessions ), BLANK (),
				        IF (
				            _sessions < [Quality Min Sessions], "Low data",
				            IF (
				                _isBig,
				                IF ( _converts, "Scale", "Fix funnel" ),
				                IF ( _converts, "Hidden gem", "Monitor" )
				            )
				        )
				    )
				```
			displayFolder: HTML cards

		/// Row template for the 'Channel quality' card (one list row per source).
		measure 'HTML Quality Row' = ```
				-- ROW template for the "Channel quality" card: one list row per traffic source.
				-- Visual fields: Context = dim_traffic_source[traffic_source], Values = this measure.
				-- Sort the visual by THIS measure, descending (the HTML comment carries the sort key = sessions).
				VAR _src      = SELECTEDVALUE ( dim_traffic_source[traffic_source], "(not set)" )
				VAR _srcHtml  = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _src, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
				VAR _sessions = [Sessions]
				VAR _rank     = [Quality Rank]
				VAR _verdict  = [Quality Verdict]
				VAR _share    = [Sessions Share]
				VAR _eng      = [Engagement rate]
				VAR _ecvr     = COALESCE ( [ECVR], 0 )
				VAR _rpu      = COALESCE ( [Revenue per user], 0 )
				VAR _bench    = CALCULATE ( [ECVR], ALLSELECTED ( dim_traffic_source ) )
				VAR _cls      = SWITCH ( _verdict, "Scale", "scale", "Fix funnel", "fix", "Hidden gem", "gem", "mute" )
				VAR _ecvrCls  = IF ( _ecvr >= _bench, "up", "down" )
				VAR _shareText = IF ( _share < 0.005, "&lt;1%", FORMAT ( _share, "0%" ) )
				VAR _sortKey  = FORMAT ( _sessions, "0000000000" )
				RETURN
				    IF (
				        _sessions > 0 && _rank <= [Quality Top N],
				        "<!--" & _sortKey & "-->"
				            & "<div class='q'>"
				            & "<div class='q-rank " & _cls & "'>" & _rank & "</div>"
				            & "<div class='q-main'><div class='q-name' title='" & _srcHtml & "'>" & _srcHtml & "</div>"
				            & "<div class='q-sub'>" & _shareText & " of sessions</div></div>"
				            & "<div class='q-num'>" & FORMAT ( _eng, "0%" ) & "</div>"
				            & "<div class='q-num " & _ecvrCls & "'>" & FORMAT ( _ecvr, "0.00%" ) & "</div>"
				            & "<div class='q-num'>" & FORMAT ( _rpu, "$#,0.00" ) & "</div>"
				            & "<div class='q-verdict'><span class='pill " & _cls & "'>" & _verdict & "</span></div>"
				            & "</div>"
				    )
				```
			displayFolder: HTML cards

		/// Body template for the 'Channel quality' card (plot, summary, header, {{content}}, legend).
		measure 'HTML Quality Body' = ```
				-- BODY template for the "Channel quality" card. Bind it to the visual's Body template (fx > Field value).
				-- Builds: title, a numbered "volume vs conversion" plot, a one-line benchmark, the column header,
				-- the {{content}} placeholder (list rows from the row measure) and the legend.
				-- The numbered markers use the same rank as the list rows, so marker 1 = list row 1.
				VAR _topN = [Quality Top N]
				VAR _src  = FILTER ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [Sessions] > 0 )
				VAR _pts =
				    ADDCOLUMNS (
				        _src,
				        "@rank", [Quality Rank],
				        "@share", [Sessions Share],
				        "@ecvr", COALESCE ( [ECVR], 0 ),
				        "@verdict", [Quality Verdict]
				    )
				VAR _active = COUNTROWS ( _pts )
				VAR _bench  = CALCULATE ( [ECVR], ALLSELECTED ( dim_traffic_source ) )
				VAR _equal  = DIVIDE ( 1, _active )
				VAR _xMax   = MAX ( 0.01, MAXX ( _pts, [@share] ) * 1.15 )
				VAR _yMax   = MAX ( 0.001, MAXX ( _pts, [@ecvr] ) * 1.15 )
				VAR _vx     = MIN ( 100, DIVIDE ( _equal, _xMax ) * 100 )
				VAR _hy     = MIN ( 100, DIVIDE ( _bench, _yMax ) * 100 )

				VAR _dots =
				    CONCATENATEX (
				        FILTER ( _pts, [@rank] <= _topN ),
				        VAR _x    = ROUND ( DIVIDE ( [@share], _xMax ) * 100, 1 )
				        VAR _y    = ROUND ( DIVIDE ( [@ecvr], _yMax ) * 100, 1 )
				        VAR _cls  = SWITCH ( [@verdict], "Scale", "scale", "Fix funnel", "fix", "Hidden gem", "gem", "mute" )
				        VAR _name = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dim_traffic_source[traffic_source], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
				        RETURN
				            "<div class='dot " & _cls & "' style='left:" & _x & "%;bottom:" & _y & "%' title='#" & [@rank] & " " & _name
				                & " - " & FORMAT ( [@share], "0%" ) & " of sessions, ECVR " & FORMAT ( [@ecvr], "0.00%" ) & "'>"
				                & [@rank] & "</div>",
				        "",
				        [@rank], ASC
				    )

				VAR _summary =
				    "All sources &middot; <b>" & FORMAT ( [Sessions], "#,0" ) & "</b> sessions &middot; <b>" & FORMAT ( [Engagement rate], "0%" )
				        & "</b> engaged &middot; <b>" & FORMAT ( _bench, "0.00%" ) & "</b> ECVR &middot; <b>" & FORMAT ( [Revenue per user], "$#,0.00" ) & "</b> per user"

				RETURN
				    "<div class='card'>"
				        & "<div class='card-head'><div class='card-title'>Channel quality</div>"
				        & "<div class='card-sub'>Do the sources that bring volume also bring buyers? &middot; " & [Period Range Label] & "</div></div>"
				        & "<div class='plot-wrap'>"
				        & "<div class='ax-y'>ECVR (0&ndash;" & FORMAT ( _yMax, "0.0%" ) & ") &rarr;</div>"
				        & "<div class='plot'>"
				        & "<div class='thr-v' style='left:" & ROUND ( _vx, 1 ) & "%'></div>"
				        & "<div class='thr-h' style='bottom:" & ROUND ( _hy, 1 ) & "%'></div>"
				        & "<span class='quad tl'>Hidden gem</span><span class='quad tr'>Scale</span>"
				        & "<span class='quad bl'>Monitor</span><span class='quad br'>Fix funnel</span>"
				        & _dots
				        & "</div>"
				        & "<div class='ax-x'>Share of sessions (0&ndash;" & FORMAT ( _xMax, "0%" ) & ") &rarr;</div>"
				        & "</div>"
				        & "<div class='summary'>" & _summary & "</div>"
				        & "<div class='q-head'><span></span><span>Source</span><span>Engaged</span><span>ECVR</span><span>$ / user</span><span>Verdict</span></div>"
				        & "<div class='q-list'>{{content}}</div>"
				        & "<div class='legend'>"
				        & "<div class='lg'><span class='pill scale'>Scale</span>big, converts above average</div>"
				        & "<div class='lg'><span class='pill fix'>Fix funnel</span>big, converts below average</div>"
				        & "<div class='lg'><span class='pill gem'>Hidden gem</span>small, converts above average</div>"
				        & "<div class='lg'><span class='pill mute'>Monitor</span>small, below average</div>"
				        & "<div class='lg-note'>Dashed lines mark the equal share (" & FORMAT ( _equal, "0%" ) & ") and the all-sources ECVR ("
				        & FORMAT ( _bench, "0.00%" ) & "). Under " & [Quality Min Sessions] & " sessions a source is shown as Low data.</div>"
				        & "</div>"
				        & "</div>"
				```
			displayFolder: HTML cards

		/// Stylesheet for the 'Channel quality' card (560 x 756 px).
		measure 'HTML Quality CSS' = ```
				"
				#htmlContent {
				  --primary: #0057CE;
				  --secondary: #D51A9F;
				  --ink: #041225;
				  --muted: #64778F;
				  --line: #E5E7EB;
				  --pos-fill: #EAF2FF;
				  --neg-fill: #FCEAF5;
				  font-family: 'Segoe UI', Arial, sans-serif;
				  font-size: 13px;
				  color: var(--ink);
				  background: #FFFFFF;
				  width: 100%;
				  height: 100%;
				  box-sizing: border-box;
				  padding: 12px 16px;
				  overflow: hidden;
				}
				.card { display: flex; flex-direction: column; height: 100%; gap: 8px; }
				.card-title { font-size: 15px; font-weight: 600; }
				.card-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
				.htmlViewerEntry { margin: 0; padding: 0; }
				.htmlViewerEntry:empty { display: none; }

				/* volume vs conversion plot */
				.plot-wrap { position: relative; height: 250px; flex: 0 0 250px; }
				.plot { position: absolute; left: 34px; right: 8px; top: 6px; bottom: 26px; border-left: 1px solid #CBD5E1; border-bottom: 1px solid #CBD5E1; }
				.thr-v { position: absolute; top: 0; bottom: 0; border-left: 1px dashed #B9C4D6; }
				.thr-h { position: absolute; left: 0; right: 0; border-top: 1px dashed #B9C4D6; }
				.quad { position: absolute; font-size: 11px; font-weight: 600; color: var(--muted); opacity: .75; }
				.quad.tl { top: 6px; left: 8px; }
				.quad.tr { top: 6px; right: 8px; }
				.quad.bl { bottom: 6px; left: 8px; }
				.quad.br { bottom: 6px; right: 8px; }
				.ax-x { position: absolute; left: 34px; right: 8px; bottom: 2px; text-align: center; font-size: 11px; color: var(--muted); }
				.ax-y { position: absolute; left: 4px; top: 6px; bottom: 26px; width: 16px; writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; font-size: 11px; color: var(--muted); }
				.dot { position: absolute; width: 26px; height: 26px; margin: 0 0 -13px -13px; border-radius: 50%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; background: #FFFFFF; }
				.dot.scale { background: var(--primary); color: #FFFFFF; }
				.dot.fix { background: var(--secondary); color: #FFFFFF; }
				.dot.gem { border: 1.5px solid var(--primary); color: var(--primary); }
				.dot.mute { border: 1.5px solid var(--muted); color: var(--muted); }

				/* benchmark line */
				.summary { font-size: 12px; color: var(--muted); padding: 2px 0 6px; border-bottom: 1px solid var(--line); }
				.summary b { color: var(--ink); font-weight: 600; }

				/* list */
				.q-head, .q { display: grid; grid-template-columns: 26px minmax(0, 1fr) 54px 58px 54px 92px; column-gap: 10px; align-items: center; }
				.q-head { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); padding: 0 2px; }
				.q-head span:nth-child(n+3):nth-child(-n+5) { text-align: right; }
				.q-head span:nth-child(6) { text-align: right; }
				.q { min-height: 44px; padding: 4px 2px; border-bottom: 1px solid #F0F2F6; }
				.q-rank { width: 24px; height: 24px; border-radius: 50%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; background: #FFFFFF; }
				.q-rank.scale { background: var(--primary); color: #FFFFFF; }
				.q-rank.fix { background: var(--secondary); color: #FFFFFF; }
				.q-rank.gem { border: 1.5px solid var(--primary); color: var(--primary); }
				.q-rank.mute { border: 1.5px solid var(--muted); color: var(--muted); }
				.q-name { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
				.q-sub { font-size: 12px; color: var(--muted); margin-top: 1px; }
				.q-num { text-align: right; font-size: 14px; font-variant-numeric: tabular-nums; }
				.q-num.up { color: var(--primary); font-weight: 600; }
				.q-num.down { color: var(--secondary); font-weight: 600; }
				.q-verdict { text-align: right; }

				/* verdict pills: only the verdicts that call for action stand out */
				.pill { display: inline-block; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
				.pill.scale { background: var(--pos-fill); color: var(--primary); }
				.pill.fix { background: var(--neg-fill); color: var(--secondary); }
				.pill.gem { background: #FFFFFF; color: var(--primary); border: 1px solid var(--primary); padding: 2px 9px; }
				.pill.mute { background: transparent; color: var(--muted); font-weight: 400; padding: 3px 0; }

				/* legend */
				.legend { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; font-size: 11.5px; color: var(--muted); padding-top: 8px; border-top: 1px solid var(--line); }
				.legend .pill { font-size: 11px; padding: 1px 8px; margin-right: 6px; }
				.legend .pill.gem { padding: 0 7px; }
				.legend .pill.mute { padding: 1px 0; margin-right: 6px; }
				.lg-note { grid-column: 1 / -1; font-size: 11px; }
				"
				```
			displayFolder: HTML cards

