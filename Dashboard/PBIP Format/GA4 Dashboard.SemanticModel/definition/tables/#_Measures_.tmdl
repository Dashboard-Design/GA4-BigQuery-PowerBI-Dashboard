table #_Measures_
	lineageTag: be05c863-c494-4a19-ada4-ccf8a1348cfa

	measure 'Total users' = DISTINCTCOUNT ( fact_events[user_key] )
		formatString: #,0
		displayFolder: User Acquisition\Base
		lineageTag: d9a6ab74-9a28-443e-a106-f613928e4bf9

	measure 'New users' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_events[user_key] ),
			    fact_events[event_name] IN { "first_visit", "first_open" }
			)
		formatString: #,0
		displayFolder: User Acquisition\Base
		lineageTag: dfbe613b-78b7-4e28-9c9f-805381298a01

	measure Sessions = COUNTROWS ( fact_sessions )
		formatString: #,0
		displayFolder: User Acquisition\Base
		lineageTag: b40c4403-c5dd-4b96-860c-ed5140c02539

	measure 'Ecommerce purchases' =
			CALCULATE (
			    COUNTROWS ( fact_events ),
			    fact_events[event_name] = "purchase"
			)
		formatString: #,0
		displayFolder: User Acquisition\Base
		lineageTag: bc19f75b-3bf2-4a5f-98e8-74353c063acf

	measure 'Purchase revenue' = SUM ( fact_events[purchase_revenue_in_usd] )
		formatString: \$#,0.00
		displayFolder: User Acquisition\Base
		lineageTag: 3298ab7a-5747-4fd0-a4c4-62d3e3d396f3

	measure ECVR = DIVIDE ( [Ecommerce purchases], [Sessions] )
		formatString: 0.00%
		displayFolder: User Acquisition\Base
		lineageTag: 3d447204-4598-44a3-9baa-51431ce93e01

	measure '% of Users' =
			DIVIDE (
			    [Total users],
			    CALCULATE ( [Total users], ALLSELECTED ( dim_traffic_source ) )
			)
		formatString: 0.00%
		displayFolder: User Acquisition\Share of total
		lineageTag: cd615eb9-8246-4d65-a498-219a2e273a87

	measure '% New Users' =
			DIVIDE (
			    [New users],
			    CALCULATE ( [New users], ALLSELECTED ( dim_traffic_source ) )
			)
		formatString: 0.00%
		displayFolder: User Acquisition\Share of total
		lineageTag: 43512097-e8fd-4e82-bb22-fbc4e93a6e9e

	measure '% Revenue' =
			DIVIDE (
			    [Purchase revenue],
			    CALCULATE ( [Purchase revenue], ALLSELECTED ( dim_traffic_source ) )
			)
		formatString: 0.00%
		displayFolder: User Acquisition\Share of total
		lineageTag: 7ed77bf6-3884-42e6-ac05-2a3039aba8ea

	measure 'KPI Value' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, [Total users],
			    1, [New users],
			    2, [Ecommerce purchases],
			    3, [ECVR],
			    4, [Purchase revenue]
			)
		displayFolder: User Acquisition\KPI Selector
		lineageTag: 0c070b45-939b-45d8-bd3d-eaefd78706d7

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
				    3, "0.00%",
				    4, "\$#,0",
				    "#,0"
				)

	measure 'KPI Delta' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, [Total users Change %],
			    1, [New users Change %],
			    2, [Ecommerce purchases Change %],
			    3, [ECVR Change %],
			    4, [Purchase revenue Change %]
			)
		formatString: \▲ 0.0%;\▼ 0.0%;0.0%
		displayFolder: User Acquisition\KPI Selector
		lineageTag: 5fb0fc38-892a-44ef-a9fd-a3bad98f9589

	measure 'KPI Chart Title' =
			"Daily " & SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, "total users",
			    1, "new users",
			    2, "ecommerce purchases",
			    3, "ECVR",
			    4, "purchase revenue",
			    "KPIs"
			)
		displayFolder: User Acquisition\KPI Selector
		lineageTag: 0f461d90-8eaa-4366-b296-98e53ec0b80e

	measure 'KPI Card SVG' =
			
			VAR _KPIOrder =
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] )
			
			-- Configuration
			VAR _W = 180
			VAR _H = 100
			
			-- Calculations
			VAR _KPIName =
			    SWITCH (
			        _KPIOrder,
			        0, "Total users",
			        1, "New users",
			        2, "Ecommerce purchases",
			        3, "ECVR",
			        4, "Purchase revenue",
			        "KPI"
			    )
			
			VAR _KPIValue = [KPI Value]
			VAR _KPIDelta = [KPI Delta]
			
			VAR _FormattedValue =
			    SWITCH (
			        _KPIOrder,
			        0, FORMAT ( _KPIValue, "#,##0" ),
			        1, FORMAT ( _KPIValue, "#,##0" ),
			        2, FORMAT ( _KPIValue, "#,##0" ),
			        3, FORMAT ( _KPIValue, "0.00%" ),
			        4, FORMAT ( _KPIValue, "$#,##0,.0K" ),
			        FORMAT ( _KPIValue, "#,##0.##" )
			    )
			
			VAR _FormattedValueEncoded =
			    SUBSTITUTE (
			        SUBSTITUTE ( _FormattedValue, "%", "%25" ),
			        "+", "%2B"
			    )
			
			VAR _FormattedDelta =
			    FORMAT ( _KPIDelta, "+0.0%;-0.0%;0.0%" )
			
			VAR _DeltaRaw =
			    IF (
			        ISBLANK ( _KPIDelta ),
			        "N/A",
			        _FormattedDelta
			    )
			
			VAR _DeltaTextEncoded =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE ( _DeltaRaw, "%", "%25" ),
			            "+", "%2B"
			        ),
			        " ", "%20"
			    )
			
			-- Colors
			VAR _LabelColor = "%2364778F" -- Muted slate
			VAR _ValueColor = "%23041225" -- Dark navy
			VAR _CardBackground = "%23FFFFFF" -- White
			
			VAR _DeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _KPIDelta ), "%2364778F",
			        _KPIDelta > 0, "%230057CE",
			        _KPIDelta < 0, "%23D51A9F",
			        "%2364778F"
			    )
			
			VAR _DeltaFill =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _KPIDelta ), "%23F3F6FA",
			        _KPIDelta > 0, "%23EAF2FF",
			        _KPIDelta < 0, "%23FCEAF5",
			        "%23F3F6FA"
			    )
			
			VAR _DeltaArrow =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _KPIDelta ), "",
			        _KPIDelta > 0, "&%239650;",
			        _KPIDelta < 0, "&%239660;",
			        ""
			    )
			
			VAR _DeltaDisplay =
			    IF (
			        ISBLANK ( _KPIDelta ),
			        "N/A",
			        IF (
			            _DeltaArrow <> "",
			            _DeltaArrow & "%20" & _DeltaTextEncoded,
			            _DeltaTextEncoded
			        )
			    )
			
			-- Geometry: adapt typography and positioning to the value
			VAR _ValueFontSize =
			    SWITCH (
			        TRUE (),
			        LEN ( _FormattedValue ) >= 13, 13,
			        LEN ( _FormattedValue ) >= 10, 18,
			        LEN ( _FormattedValue ) >= 8, 20,
			        24
			    )
			
			VAR _EstimatedValueWidth =
			    LEN ( _FormattedValue ) * _ValueFontSize * 0.64
			
			VAR _DeltaX =
			    12 + _EstimatedValueWidth + 4
			
			VAR _DeltaXText =
			    FORMAT ( _DeltaX, "0" )
			
			VAR _DeltaCenterX =
			    FORMAT ( _DeltaX + 34, "0" )
			
			-- SVG
			VAR _SVG =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%25' height='100%25' viewBox='-2 -2 184 104' overflow='visible' display='block'>"
			        & "<rect x='1' y='1' width='178' height='98' rx='7' fill='" & _CardBackground & "'/>"
			        & "<text x='12' y='26' font-family='Segoe UI,Arial,sans-serif' font-size='14' font-weight='500' fill='" & _LabelColor & "'>"
			        & _KPIName
			        & "</text>"
			        & "<text x='12' y='63' font-family='Segoe UI,Arial,sans-serif' font-size='" & FORMAT ( _ValueFontSize, "0" ) & "' font-weight='600' fill='" & _ValueColor & "'>"
			        & _FormattedValueEncoded
			        & "</text>"
			        & "<rect x='" & _DeltaXText & "' y='43' width='68' height='22' rx='5' fill='" & _DeltaFill & "'/>"
			        & "<text x='" & _DeltaCenterX & "' y='58' text-anchor='middle' font-family='Segoe UI,Arial,sans-serif' font-size='11' font-weight='600' fill='" & _DeltaColor & "'>"
			        & _DeltaDisplay
			        & "</text>"
			        & "</svg>"
			
			RETURN
			    IF (
			        HASONEVALUE ( 'KPI Selector'[KPI Selector Order] ),
			        "data:image/svg+xml;charset=utf-8," & _SVG,
			        BLANK ()
			    )
		displayFolder: KPI Card
		lineageTag: ae5cf1d5-9f82-4e82-8527-7e46bdff8a93
		dataCategory: ImageUrl

	measure '</> Slicer Filter' = ```
			INT( NOT ISEMPTY( fact_sessions ) )    // replace it with your own fact table
			
			```
		formatString: 0
		lineageTag: 8f598c12-6270-48a8-b944-02737b969db0

	/// First day of the range selected in the date slicer (read even inside a daily axis).
	measure 'Period Start' = CALCULATE ( MIN ( dim_date[date_key] ), ALLSELECTED ( dim_date ) )
		formatString: d mmm yyyy
		displayFolder: Period comparison\Helpers
		lineageTag: 92ae01cc-0d28-43b2-beb4-92b4e8615bef

	/// Last day of the range selected in the date slicer.
	measure 'Period End' = CALCULATE ( MAX ( dim_date[date_key] ), ALLSELECTED ( dim_date ) )
		formatString: d mmm yyyy
		displayFolder: Period comparison\Helpers
		lineageTag: fe74defa-7528-4d03-bae7-c62aa8aa59b2

	measure 'Period Days' = DATEDIFF ( [Period Start], [Period End], DAY ) + 1
		formatString: 0
		displayFolder: Period comparison\Helpers
		lineageTag: 8509434a-e47c-4469-a372-f4adb1a6d3d6

	/// Previous period = the same number of days immediately before the selected range.
	measure 'Comparison Start' = [Period Start] - [Period Days]
		formatString: d mmm yyyy
		displayFolder: Period comparison\Helpers
		lineageTag: 71b38b9f-f0d1-46ce-9d59-811bd778cb69

	measure 'Comparison End' = [Period Start] - 1
		formatString: d mmm yyyy
		displayFolder: Period comparison\Helpers
		lineageTag: 72513ba5-c04a-4713-ab14-7bf84f0e385e

	measure 'Comparison Caption' = "vs. previous period"
		displayFolder: Period comparison\Helpers
		lineageTag: ecf24aa9-7094-496e-9071-0dbb0b3a3da3

	measure 'Period Range Label' = FORMAT ( [Period Start], "d mmm yyyy" ) & " – " & FORMAT ( [Period End], "d mmm yyyy" )
		displayFolder: Period comparison\Helpers
		lineageTag: 2cf78dff-60fb-4655-ae9b-0e503313fcaf

	measure 'Comparison Range Label' = FORMAT ( [Comparison Start], "d mmm yyyy" ) & " – " & FORMAT ( [Comparison End], "d mmm yyyy" )
		displayFolder: Period comparison\Helpers
		lineageTag: 29ad17ee-9593-4e4b-b7be-694c31c03e53

	/// Previous period = same number of days immediately before the slicer range. Blank if that window starts before the first day of data.
	measure 'Total users (Comparison)' =
			VAR _start = [Comparison Start]
			VAR _end   = [Comparison End]
			RETURN
			    IF (
			        _start >= [First Data Date],
			        CALCULATE (
			            [Total users],
			            REMOVEFILTERS ( dim_date ),
			            DATESBETWEEN ( dim_date[date_key], _start, _end )
			        )
			    )
		formatString: #,0
		displayFolder: Period comparison\Previous period
		lineageTag: b4b6ae36-fe16-437c-a6cc-140a7b034f2a

	measure 'New users (Comparison)' =
			VAR _start = [Comparison Start]
			VAR _end   = [Comparison End]
			RETURN
			    IF (
			        _start >= [First Data Date],
			        CALCULATE (
			            [New users],
			            REMOVEFILTERS ( dim_date ),
			            DATESBETWEEN ( dim_date[date_key], _start, _end )
			        )
			    )
		formatString: #,0
		displayFolder: Period comparison\Previous period
		lineageTag: e2f79d4b-f037-496d-8a00-cf888e134d41

