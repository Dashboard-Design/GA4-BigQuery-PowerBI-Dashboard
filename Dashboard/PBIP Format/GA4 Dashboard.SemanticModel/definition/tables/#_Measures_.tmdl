	measure 'KPI Card SVG Selected' =
			
			VAR _KPIOrder =
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] )
			
			-- Configuration
			VAR _W = 180
			VAR _H = 100
			
			-- Calculations
			VAR _KPIName =
			    SWITCH (
			        _KPIOrder,
			        0, "Total users",
			        1, "New users",
			        2, "Ecommerce purchases",
			        3, "ECVR",
			        4, "Purchase revenue",
			        "KPI"
			    )
			
			VAR _KPIValue = [KPI Value]
			VAR _KPIDelta = [KPI Delta]
			
			VAR _FormattedValue =
			    SWITCH (
			        _KPIOrder,
			        0, FORMAT ( _KPIValue, "#,##0" ),
			        1, FORMAT ( _KPIValue, "#,##0" ),
			        2, FORMAT ( _KPIValue, "#,##0" ),
			        3, FORMAT ( _KPIValue, "0.00%" ),
			        4, FORMAT ( _KPIValue, "$#,##0,.0K" ),
			        FORMAT ( _KPIValue, "#,##0.##" )
			    )
			
			VAR _FormattedValueEncoded =
			    SUBSTITUTE (
			        SUBSTITUTE ( _FormattedValue, "%", "%25" ),
			        "+", "%2B"
			    )
			
			VAR _FormattedDelta =
			    FORMAT ( _KPIDelta, "+0.0%;-0.0%;0.0%" )
			
			VAR _DeltaRaw =
			    IF (
			        ISBLANK ( _KPIDelta ),
			        "N/A",
			        _FormattedDelta
			    )
			
			VAR _DeltaTextEncoded =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE ( _DeltaRaw, "%", "%25" ),
			            "+", "%2B"
			        ),
			        " ", "%20"
			    )
			
			-- Colors
			VAR _LabelColor = "%230057CE" -- Selected blue
			VAR _ValueColor = "%23041225" -- Dark navy
			VAR _AccentBlue = "%230057CE" -- Selection underline
			VAR _CardBackground = "%23FFFFFF" -- White
			
			VAR _DeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _KPIDelta ), "%2364778F",
			        _KPIDelta > 0, "%230057CE",
			        _KPIDelta < 0, "%23D51A9F",
			        "%2364778F"
			    )
			
			VAR _DeltaFill =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _KPIDelta ), "%23F3F6FA",
			        _KPIDelta > 0, "%23EAF2FF",
			        _KPIDelta < 0, "%23FCEAF5",
			        "%23F3F6FA"
			    )
			
			VAR _DeltaArrow =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _KPIDelta ), "",
			        _KPIDelta > 0, "&%239650;",
			        _KPIDelta < 0, "&%239660;",
			        ""
			    )
			
			VAR _DeltaDisplay =
			    IF (
			        ISBLANK ( _KPIDelta ),
			        "N/A",
			        IF (
			            _DeltaArrow <> "",
			            _DeltaArrow & "%20" & _DeltaTextEncoded,
			            _DeltaTextEncoded
			        )
			    )
			
			-- Geometry: adapt typography and positioning to the value
			VAR _ValueFontSize =
			    SWITCH (
			        TRUE (),
			        LEN ( _FormattedValue ) >= 13, 13,
			        LEN ( _FormattedValue ) >= 10, 18,
			        LEN ( _FormattedValue ) >= 8, 20,
			        24
			    )
			
			VAR _EstimatedValueWidth =
			    LEN ( _FormattedValue ) * _ValueFontSize * 0.64
			
			VAR _DeltaX =
			    12 + _EstimatedValueWidth + 4
			
			VAR _DeltaXText =
			    FORMAT ( _DeltaX, "0" )
			
			VAR _DeltaCenterX =
			    FORMAT ( _DeltaX + 34, "0" )
			
			-- SVG
			VAR _SVG =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%25' height='100%25' viewBox='-2 -2 184 104' overflow='visible' display='block'>"
			        & "<rect x='1' y='1' width='178' height='98' rx='7' fill='" & _CardBackground & "'/>"
			        & "<text x='12' y='26' font-family='Segoe UI,Arial,sans-serif' font-size='14' font-weight='600' fill='" & _LabelColor & "'>"
			        & _KPIName
			        & "</text>"
			        & "<text x='12' y='63' font-family='Segoe UI,Arial,sans-serif' font-size='" & FORMAT ( _ValueFontSize, "0" ) & "' font-weight='700' fill='" & _ValueColor & "'>"
			        & _FormattedValueEncoded
			        & "</text>"
			        & "<rect x='" & _DeltaXText & "' y='43' width='68' height='22' rx='5' fill='" & _DeltaFill & "'/>"
			        & "<text x='" & _DeltaCenterX & "' y='58' text-anchor='middle' font-family='Segoe UI,Arial,sans-serif' font-size='11' font-weight='600' fill='" & _DeltaColor & "'>"
			        & _DeltaDisplay
			        & "</text>"
			        & "<rect x='20' y='81' width='140' height='3' rx='1.5' fill='" & _AccentBlue & "'/>"
			        & "</svg>"
			
			RETURN
			    IF (
			        HASONEVALUE ( 'KPI Selector'[KPI Selector Order] ),
			        "data:image/svg+xml;charset=utf-8," & _SVG,
			        BLANK ()
			    )
		displayFolder: KPI Card
		lineageTag: 783d68be-2a47-4298-8011-21b750c1b32e
		dataCategory: ImageUrl

	measure 'KPI Comparison' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, [Total users (Comparison)],
			    1, [New users (Comparison)],
			    2, [Ecommerce purchases (Comparison)],
			    3, [ECVR (Comparison)],
			    4, [Purchase revenue (Comparison)]
			)
		displayFolder: Period comparison\Selected KPI table
		lineageTag: 558e9455-a387-4f5c-bd26-b4bdd05546b8

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
				    3, "0.00%",
				    4, "\$#,0",
				    "#,0"
				)

	measure 'KPI Share of Total' =
			IF (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ) = 3,
			    BLANK (),    -- a rate (ECVR) has no meaningful share of total
			    DIVIDE (
			        [KPI Value],
			        CALCULATE ( [KPI Value], ALLSELECTED ( dim_traffic_source ) )
			    )
			)
		formatString: 0.0%
		displayFolder: Period comparison\Selected KPI table
		lineageTag: c44d6e94-ec22-429b-8f99-36de70beb261

	measure 'KPI Target Bar' =
			-- Same logic as UDF_TargetLineBarChart, inlined as a regular measure.
			-- Bar = selected KPI for the selected period; dashed line = comparison period.
			
			-- Colors (# encoded as %23 so the data URI stays valid)
			VAR _AboveColor  = "%230057CE"   -- primary:   at/above comparison
			VAR _BelowColor  = "%23D51A9F"   -- secondary: below comparison
			VAR _TrackColor  = "%23E6EDF8"   -- light tint of primary
			VAR _TargetColor = "%23041225"   -- main text color
			
			-- Geometry
			VAR _ChartHeight = 35
			VAR _BarHeight   = 28
			VAR _AxisMin     = 0
			VAR _AxisMax     = 130
			
			-- Values
			VAR _Actual      = [KPI Value]
			VAR _Target      = [KPI Comparison]
			VAR _HasTarget   = NOT ISBLANK ( _Target )
			VAR _Performance = DIVIDE ( _Actual - _Target, _Target )
			VAR _Range       = _AxisMax - _AxisMin
			
			-- Common scale across all traffic sources shown
			VAR _MaxActual =
			    CALCULATE (
			        MAXX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [KPI Value] ),
			        REMOVEFILTERS ( dim_traffic_source[traffic_source] )
			    )
			VAR _MaxTarget =
			    CALCULATE (
			        MAXX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [KPI Comparison] ),
			        REMOVEFILTERS ( dim_traffic_source[traffic_source] )
			    )
			VAR _GlobalMax = MAX ( _MaxActual, _MaxTarget ) * 1.15
			
			VAR _ActualWidth = MAX ( 0, DIVIDE ( _Actual, _GlobalMax ) * _Range )
			VAR _TargetPos   = _AxisMin + DIVIDE ( _Target, _GlobalMax ) * _Range
			VAR _BarColor    = IF ( _HasTarget && _Performance < 0, _BelowColor, _AboveColor )
			VAR _BarY        = ( _ChartHeight - _BarHeight ) / 2
			
			VAR _SVG =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100%25' height='100%25' viewBox='0 0 "
			        & _AxisMax & " " & _ChartHeight & "' preserveAspectRatio='none'>"
			    & "<rect x='" & _AxisMin & "' y='" & _BarY & "' width='" & _Range & "' height='" & _BarHeight
			        & "' fill='" & _TrackColor & "' rx='4' ry='4'/>"
			    & "<rect x='" & _AxisMin & "' y='" & _BarY & "' width='" & _ActualWidth & "' height='" & _BarHeight
			        & "' fill='" & _BarColor & "' rx='4' ry='4'/>"
			    & IF (
			        _HasTarget,
			        "<line x1='" & _TargetPos & "' y1='0' x2='" & _TargetPos & "' y2='" & _ChartHeight
			            & "' stroke='" & _TargetColor & "' stroke-width='2' stroke-dasharray='4 2'/>",
			        ""
			    )
			    & "</svg>"
			
			RETURN
			    IF (
			        HASONEVALUE ( dim_traffic_source[traffic_source] ) && NOT ISBLANK ( _Actual ),
			        _SVG
			    )
		displayFolder: Period comparison\Selected KPI table
		lineageTag: b02f9b23-c0ca-4d7c-a223-f8f1c2ec60d4
		dataCategory: ImageUrl

	measure 'KPI Table Title' =
			"Acquisition by traffic source – " & SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, "Total users",
			    1, "New users",
			    2, "Ecommerce purchases",
			    3, "ECVR",
			    4, "Purchase revenue",
			    "KPIs"
			)
		displayFolder: Period comparison\Selected KPI table
		lineageTag: 10a9bc79-44a7-4ede-918e-3a004b479a07

	measure 'KPI Table Subtitle' = [Period Range Label] & "  " & [Comparison Caption] & "  (" & [Comparison Range Label] & ")"
		displayFolder: Period comparison\Selected KPI table
		lineageTag: 75152273-45a2-4c77-9b49-02d50c10c1a6

	/// Value for the selected KPI in the configured comparison period.
	measure 'KPI Comparison Value' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, [Total users (Comparison)],
			    1, [New users (Comparison)],
			    2, [Ecommerce purchases (Comparison)],
			    3, [ECVR (Comparison)],
			    4, [Purchase revenue (Comparison)]
			)
		displayFolder: User Acquisition\KPI Selector
		lineageTag: e15cdd6a-f775-4436-8e05-28f60ac9b59d

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
				    3, "0.00%",
				    4, "\$#,0",
				    "#,0"
				)

	/// SVG bar: selected-period KPI in blue with comparison-period target marker in magenta.
	measure 'KPI Target Line Bar SVG' =
			VAR _Actual = [KPI Value]
			VAR _Target = [KPI Comparison Value]
			VAR _MaxActual =
			    CALCULATE (
			        MAXX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [KPI Value] ),
			        REMOVEFILTERS ( dim_traffic_source[traffic_source] )
			    )
			VAR _MaxTarget =
			    CALCULATE (
			        MAXX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [KPI Comparison Value] ),
			        REMOVEFILTERS ( dim_traffic_source[traffic_source] )
			    )
			VAR _ScaleMax = MAX ( _MaxActual, _MaxTarget )
			VAR _ChartWidth = 180
			VAR _ChartHeight = 34
			VAR _BarWidth = MAX ( 0, DIVIDE ( _Actual, _ScaleMax, 0 ) * _ChartWidth )
			VAR _TargetX = MIN ( _ChartWidth, MAX ( 0, DIVIDE ( _Target, _ScaleMax, 0 ) * _ChartWidth ) )
			VAR _TargetLine =
			    IF (
			        NOT ISBLANK ( _Target ),
			        "<line x1='" & FORMAT ( _TargetX, "0.0" ) & "' y1='3' x2='" & FORMAT ( _TargetX, "0.0" ) & "' y2='31' stroke='%23D51A9F' stroke-width='3'/>",
			        ""
			    )
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%25' height='100%25' viewBox='0 0 180 34' preserveAspectRatio='none'>"
			        & "<rect x='0' y='7' width='180' height='20' rx='3' fill='%23041225' fill-opacity='0.08'/>"
			        & "<rect x='0' y='7' width='" & FORMAT ( _BarWidth, "0.0" ) & "' height='20' rx='3' fill='%230057CE'/>"
			        & _TargetLine
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _Actual ), "data:image/svg+xml;utf8," & _Svg )
		formatString: @
		displayFolder: User Acquisition\KPI Selector
		lineageTag: 3ef7d35f-d496-44b9-9616-ea6eb5e7c2c9
		dataCategory: ImageUrl

	/// First day with data in the model (ignores all filters).
	measure 'First Data Date' = CALCULATE ( MIN ( fact_events[date_key] ), REMOVEFILTERS () )
		formatString: d mmm yyyy
		displayFolder: Period comparison\Helpers
		lineageTag: 75b1208c-ac14-4804-b36b-aeaf40604ec7

	/// TRUE when the previous period lies fully inside the loaded data, so comparison visuals can be trusted.
	measure 'KPI Comparison Available' = [Comparison Start] >= [First Data Date]
		displayFolder: IBCS table
		lineageTag: dfa01a4b-bd87-4cc0-bca6-5d6d9df40954

	/// Number format of the selected KPI, used to format SVG labels.
	measure 'KPI Format String' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    3, "0.00%",
			    4, "$#,0",
			    "#,0"
			)
		displayFolder: IBCS table
		lineageTag: b349dd27-d4b4-464f-a5af-5e6947d31342

	/// Formatted current value of the selected KPI, safe to embed in an SVG data URI (% encoded).
	measure 'KPI Label Current' = SUBSTITUTE ( FORMAT ( [KPI Value], [KPI Format String] ), "%", "%25" )
		displayFolder: IBCS table
		lineageTag: aa49d84e-3490-48b3-9965-a8c9d4f0c513

	/// Absolute change vs the previous period, formatted per KPI (ECVR in percentage points).
	measure 'KPI Label Delta' =
			VAR _delta = [KPI Value] - COALESCE ( [KPI Comparison], 0 )
			RETURN
			    SWITCH (
			        SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			        3, FORMAT ( _delta * 100, "+0.00;-0.00;0.00" ) & " pp",
			        4, FORMAT ( _delta, "+$#,0;-$#,0;$0" ),
			        FORMAT ( _delta, "+#,0;-#,0;0" )
			    )
		displayFolder: IBCS table
		lineageTag: 5aead036-b5f5-48d2-ad11-dde8040d7e91

	/// IBCS bar: selected KPI, current period (blue) over previous period (grey). Set data category to Image URL.
	measure 'KPI IBCS Bar' =
			-- IBCS bar: selected KPI for the selected period (blue bar) over the previous period (grey bar).
			-- Adapted from PowerofBI.IBCS.BarChart.AbsoluteValues (MIT licence, Andrzej Leszkiewicz).
			-- Set the table column's Cell elements > Image width / height to _W x _H below.
			
			-- Layout
			VAR _W = 200
			VAR _H = 30
			VAR _Em = _H * 0.48
			VAR _LabelPad = _Em * 0.3
			
			-- Colors (# encoded as %23 so the data URI stays valid)
			VAR _ColorCurrent  = "%230057CE"   -- primary
			VAR _ColorPrevious = "%23B9C4D6"   -- muted slate tint
			VAR _ColorText     = "%23041225"   -- main text
			VAR _ColorAxis     = "%2364778F"   -- muted slate
			
			-- Values
			VAR _Actual  = [KPI Value]
			VAR _HasBase = [KPI Comparison Available]
			VAR _Base    = IF ( _HasBase, COALESCE ( [KPI Comparison], 0 ) )
			VAR _IsRow   = ISINSCOPE ( dim_traffic_source[traffic_source] )
			VAR _ValueMax =
			    MAXX (
			        ALLSELECTED ( dim_traffic_source[traffic_source] ),
			        MAX ( [KPI Value], [KPI Comparison] )
			    )
			VAR _Scale     = DIVIDE ( _W * 0.76, _ValueMax )
			VAR _WidthCur  = ROUND ( _Actual * _Scale, 0 )
			VAR _WidthPrev = ROUND ( _Base * _Scale, 0 )
			VAR _LabelX    = MAX ( _WidthCur, _WidthPrev ) + _LabelPad
			VAR _Label     = [KPI Label Current]
			-- Sort key embedded in the SVG so the column can be sorted
			VAR _Rank = 1000000000000 + ROUND ( DIVIDE ( _Actual, _ValueMax ) * 1000000, 0 )
			
			-- SVG
			VAR _Open =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W & "' height='" & _H & "'>"
			VAR _Style =
			    "<style>text{font-family:'Segoe UI',sans-serif;font-size:" & _Em & "px;dominant-baseline:central;}</style>"
			VAR _Previous =
			    IF (
			        _HasBase,
			        "<rect x='0' y='0.5' width='" & _WidthPrev & "' height='" & _Em & "' fill='" & _ColorPrevious & "'/>",
			        ""
			    )
			VAR _Current =
			    "<rect x='0' y='" & ( _H - _Em ) / 2 & "' width='" & _WidthCur & "' height='" & _Em & "' fill='" & _ColorCurrent & "'/>"
			VAR _Axis =
			    "<line x1='0.5' x2='0.5' y1='0' y2='" & _H & "' stroke='" & _ColorAxis & "' stroke-width='1'/>"
			VAR _Text =
			    "<text x='" & _LabelX & "' y='" & _H / 2 & "' fill='" & _ColorText & "'>" & _Label & "</text>"
			VAR _TextTotal =
			    "<text x='2' y='" & _H / 2 & "' fill='" & _ColorText & "' font-weight='bold'>" & _Label & "</text>"
			VAR _SvgRow   = _Open & _Style & "/*SortBy:" & _Rank & "*/" & _Previous & _Current & _Axis & _Text & "</svg>"
			VAR _SvgTotal = _Open & _Style & _TextTotal & "</svg>"
			
			RETURN
			    IF ( ISBLANK ( _Actual ), BLANK (), IF ( _IsRow, _SvgRow, _SvgTotal ) )
		displayFolder: IBCS table
		lineageTag: f8727bd3-e35b-4ba1-a4a3-cf0551180097
		dataCategory: ImageUrl

	/// IBCS variance bar: absolute change vs the previous period, diverging from a centre axis.
	measure 'KPI IBCS Variance' =
			-- IBCS variance bar: absolute change vs the previous period, diverging from a centre axis.
			-- Blue = increase, magenta = decrease (your palette; all five KPIs are "higher is better").
			-- Adapted from PowerofBI.IBCS.BarChart.AbsoluteVariance (MIT licence, Andrzej Leszkiewicz).
			-- Scaled to the largest change in the table so small changes stay readable.
			
			-- Layout
			VAR _W = 200
			VAR _H = 30
			VAR _Em = _H * 0.48
			VAR _LabelPad = _Em * 0.3
			
			-- Colors (# encoded as %23 so the data URI stays valid)
			VAR _ColorUp   = "%230057CE"   -- primary
			VAR _ColorDown = "%23D51A9F"   -- secondary
			VAR _ColorText = "%23041225"   -- main text
			VAR _ColorAxis = "%2364778F"   -- muted slate
			
			-- Values
			VAR _Available = [KPI Comparison Available]
			VAR _Actual    = [KPI Value]
			VAR _Var       = _Actual - COALESCE ( [KPI Comparison], 0 )
			VAR _IsRow     = ISINSCOPE ( dim_traffic_source[traffic_source] )
			VAR _MaxAbs =
			    MAXX (
			        ALLSELECTED ( dim_traffic_source[traffic_source] ),
			        ABS ( [KPI Value] - COALESCE ( [KPI Comparison], 0 ) )
			    )
			VAR _AxisX  = _W / 2
			VAR _Scale  = DIVIDE ( _W * 0.36, _MaxAbs )
			VAR _Width  = ROUND ( ABS ( _Var ) * _Scale, 0 )
			VAR _Up     = _Var >= 0
			VAR _X      = IF ( _Up, _AxisX, _AxisX - _Width )
			VAR _Color  = IF ( _Up, _ColorUp, _ColorDown )
			VAR _Anchor = IF ( _Up, "start", "end" )
			VAR _LabelX = IF ( _Up, _AxisX + _Width + _LabelPad, _AxisX - _Width - _LabelPad )
			VAR _Label  = [KPI Label Delta]
			VAR _Rank   = 1000000000000 + ROUND ( DIVIDE ( _Var + _MaxAbs, 2 * _MaxAbs ) * 1000000, 0 )
			
			-- SVG
			VAR _Open =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W & "' height='" & _H & "'>"
			VAR _Style =
			    "<style>text{font-family:'Segoe UI',sans-serif;font-size:" & _Em & "px;dominant-baseline:central;}</style>"
			VAR _AxisLine =
			    "<line x1='" & _AxisX & "' x2='" & _AxisX & "' y1='0' y2='" & _H & "' stroke='" & _ColorAxis & "' stroke-width='1'/>"
			VAR _Bar =
			    "<rect x='" & _X & "' y='" & ( _H - _Em ) / 2 & "' width='" & _Width & "' height='" & _Em & "' fill='" & _Color & "'/>"
			VAR _Text =
			    "<text x='" & _LabelX & "' y='" & _H / 2 & "' fill='" & _ColorText & "' text-anchor='" & _Anchor & "'>" & _Label & "</text>"
			VAR _TextTotal =
			    "<text x='" & _AxisX & "' y='" & _H / 2 & "' fill='" & _ColorText & "' text-anchor='middle' font-weight='bold'>" & _Label & "</text>"
			VAR _SvgRow   = _Open & _Style & "/*SortBy:" & _Rank & "*/" & _AxisLine & _Bar & _Text & "</svg>"
			VAR _SvgTotal = _Open & _Style & _TextTotal & "</svg>"
			
			RETURN
			    IF (
			        NOT _Available || ISBLANK ( _Actual ),
			        BLANK (),
			        IF ( _IsRow, _SvgRow, _SvgTotal )
			    )
		displayFolder: IBCS table
		lineageTag: fb00df68-b817-4213-ac35-22fb64548f97
		dataCategory: ImageUrl

	/// IBCS pin chart: relative change (%) vs the previous period, capped at +/-100%.
	measure 'KPI IBCS Pin' =
			-- IBCS pin chart: relative change (%) vs the previous period. Pins are capped at +/-100%;
			-- larger changes show a triangle, and a source with no previous value shows "NEW".
			-- Adapted from PowerofBI.IBCS.BarChart.RelativeVariance (MIT licence, Andrzej Leszkiewicz).
			
			-- Layout
			VAR _W = 200
			VAR _H = 30
			VAR _Em = _H * 0.48
			VAR _LabelPad = _Em * 0.3
			VAR _HeadW = _Em * 0.5
			VAR _HeadH = _Em * 0.9
			
			-- Colors (# encoded as %23 so the data URI stays valid)
			VAR _ColorUp   = "%230057CE"   -- primary
			VAR _ColorDown = "%23D51A9F"   -- secondary
			VAR _ColorText = "%23041225"   -- main text
			VAR _ColorAxis = "%23C9D3E3"   -- light slate
			
			-- Values
			VAR _Available = [KPI Comparison Available]
			VAR _Actual    = [KPI Value]
			VAR _Base      = COALESCE ( [KPI Comparison], 0 )
			VAR _IsRow     = ISINSCOPE ( dim_traffic_source[traffic_source] )
			VAR _IsNew     = _Actual > 0 && _Base = 0
			VAR _NoData    = NOT _Available || ISBLANK ( _Actual ) || ( _Actual = 0 && _Base = 0 )
			VAR _Pct       = IF ( _Base = 0, BLANK (), ROUND ( DIVIDE ( _Actual - _Base, _Base ) * 100, 0 ) )
			VAR _PctCapped = SIGN ( _Pct ) * MIN ( 100, ABS ( _Pct ) )
			VAR _IsOutlier = ABS ( _Pct ) > 100
			VAR _AxisX     = _W / 2
			VAR _Width     = ROUND ( ABS ( _PctCapped ) / 100 * _W * 0.30, 0 )
			VAR _Up        = _Pct >= 0
			VAR _Tip       = IF ( _Up, _AxisX + _Width, _AxisX - _Width )
			VAR _X         = IF ( _Up, _AxisX, _AxisX - _Width )
			VAR _Color     = IF ( _Up, _ColorUp, _ColorDown )
			VAR _Span      = IF ( _IsOutlier, _Em * 0.9, _HeadW / 2 )
			VAR _Label     = IF ( _IsNew, "NEW", FORMAT ( _Pct, "+0;-0;0" ) & "%25" )
			VAR _LabelX    = IF ( _IsNew, _AxisX + _LabelPad, IF ( _Up, _Tip + _Span + _LabelPad, _Tip - _Span - _LabelPad ) )
			VAR _Anchor    = IF ( _IsNew || _Up, "start", "end" )
			VAR _Rank      = 1000000000000 + ROUND ( MAX ( -1000, MIN ( 1000, COALESCE ( _Pct, 1000 ) ) ) + 1000, 0 )
			
			-- SVG
			VAR _Open =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W & "' height='" & _H & "'>"
			VAR _Style =
			    "<style>text{font-family:'Segoe UI',sans-serif;font-size:" & _Em & "px;dominant-baseline:central;}</style>"
			VAR _AxisLine =
			    "<line x1='" & _AxisX & "' x2='" & _AxisX & "' y1='0' y2='" & _H & "' stroke='" & _ColorAxis & "' stroke-width='2'/>"
			VAR _PinBar =
			    IF (
			        _IsNew || ISBLANK ( _Pct ),
			        "",
			        "<rect x='" & _X & "' y='" & _H / 2 - _Em * 0.12 & "' width='" & _Width & "' height='" & _Em * 0.24 & "' fill='" & _Color & "'/>"
			    )
			VAR _PinHead =
			    IF (
			        _IsNew || ISBLANK ( _Pct ),
			        "",
			        IF (
			            _IsOutlier,
			            "<text x='" & _Tip & "' y='" & _H / 2 & "' fill='" & _Color & "' text-anchor='" & IF ( _Up, "start", "end" ) & "'>"
			                & IF ( _Up, UNICHAR ( 9656 ), UNICHAR ( 9666 ) ) & "</text>",
			            "<rect x='" & _Tip - _HeadW / 2 & "' y='" & ( _H - _HeadH ) / 2 & "' width='" & _HeadW & "' height='" & _HeadH & "' fill='" & _ColorText & "'/>"
			        )
			    )
			VAR _Text =
			    "<text x='" & _LabelX & "' y='" & _H / 2 & "' fill='" & _ColorText & "' text-anchor='" & _Anchor & "'>" & _Label & "</text>"
			VAR _TextTotal =
			    "<text x='" & _AxisX & "' y='" & _H / 2 & "' fill='" & _ColorText & "' text-anchor='middle' font-weight='bold'>" & _Label & "</text>"
			VAR _SvgRow   = _Open & _Style & "/*SortBy:" & _Rank & "*/" & _AxisLine & _PinBar & _PinHead & _Text & "</svg>"
			VAR _SvgTotal = _Open & _Style & _TextTotal & "</svg>"
			
			RETURN
			    IF ( _NoData, BLANK (), IF ( _IsRow, _SvgRow, _SvgTotal ) )
		displayFolder: IBCS table
		lineageTag: 159a5364-cd74-411b-8d84-f90c39723f47
		dataCategory: ImageUrl

	measure 'HTML Card 1 - Geographic Acquisition' = ```
			
			VAR _MaxRows = 6
			
			// Get Top Countries by New Users
			VAR _TopCountries = 
			    TOPN(
			        _MaxRows, 
			        VALUES(dim_geo[country]), 
			        [New users], DESC
			    )
			
			// Max value for bar scaling
			VAR _MaxUsers = MAXX(_TopCountries, [New users])
			
			// Generate HTML Rows
			VAR _RowsHTML = 
			    CONCATENATEX(
			        _TopCountries,
			        VAR _Country = dim_geo[country]
			        VAR _NewUsers = [New users]
			        VAR _ECVR = [ECVR]
			        VAR _ECVR_Formatted = FORMAT(_ECVR, "0.0%")
			        
			        // Bar width percentage (max 100%)
			        VAR _BarPct = DIVIDE(_NewUsers, _MaxUsers) * 100
			        
			        // Badge styling based on ECVR threshold (e.g., > 1% is good)
			        VAR _BadgeClass = IF(_ECVR >= 0.01, "badge-good", "badge-bad")
			        
			        RETURN
			            "<div class='list-item'>" &
			                "<div class='item-label' title='" & _Country & "'>" & _Country & "</div>" &
			                "<div class='item-value'>" & FORMAT(_NewUsers, "#,0") & "</div>" &
			                "<div class='bar-container'>" &
			                    "<div class='bar-fill' style='width: " & _BarPct & "%;'></div>" &
			                "</div>" &
			                "<div class='badge " & _BadgeClass & "'>" & _ECVR_Formatted & "</div>" &
			            "</div>",
			        "",
			        [New users], DESC
			    )
			
			// Combine into final HTML
			VAR _HTML = 
			    "<div class='matrix-card'>" &
			        "<div class='card-header'>Geographic Acquisition</div>" &
			        "<div class='card-subtitle'>Top countries by new users vs conversion rate</div>" &
			        _RowsHTML &
			    "</div>"
			
			RETURN _HTML
			```
		lineageTag: 7b7c5b89-a5ed-472f-a4e6-04593bd11037

	measure 'HTML Card 2 - Device Momentum' = ```
			
			// Configuration
			VAR _Width = 438
			VAR _Height = 385
			VAR _HeaderHeight = 60
			VAR _RowHeight = 45
			VAR _MaxRows = 5
			
			// Colors (Encoded for SVG data URI)
			VAR _BgColor = "%23FFFFFF"
			VAR _TextDark = "%23041225"
			VAR _TextMuted = "%2364778F"
			VAR _ColorPos = "%230057CE"   // Blue for Positive
			VAR _ColorNeg = "%23D51A9F"   // Magenta for Negative
			VAR _AxisColor = "%23C9D3E3"
			
			// Get Device Categories
			VAR _Devices = 
			    TOPN(
			        _MaxRows, 
			        VALUES(dim_device[device_category]), 
			        [New users], DESC
			    )
			
			// Calculate Max absolute change for scaling
			VAR _MaxChange = 
			    MAXX(
			        _Devices, 
			        ABS([New users] - [New users (Comparison)])
			    )
			
			// Generate Rows
			VAR _RowsHTML = 
			    CONCATENATEX(
			        _Devices,
			        VAR _DeviceName = dim_device[device_category]
			        VAR _Actual = [New users]
			        VAR _Comparison = [New users (Comparison)]
			        VAR _Change = _Actual - COALESCE(_Comparison, 0)
			        VAR _ChangePct = [New users Change %]
			        
			        // Bar logic (Diverging)
			        VAR _AxisX = 219 // Center of the 438 width
			        VAR _Scale = DIVIDE(_AxisX - 20, _MaxChange) // Leave 20px padding
			        VAR _BarWidth = ROUND(ABS(_Change) * _Scale, 0)
			        VAR _IsPositive = _Change >= 0
			        VAR _BarX = IF(_IsPositive, _AxisX, _AxisX - _BarWidth)
			        VAR _BarColor = IF(_IsPositive, _ColorPos, _ColorNeg)
			        
			        // Labels
			        VAR _SafeDevice = IF(ISBLANK(_DeviceName), "Unknown", SUBSTITUTE(_DeviceName, "&", "&amp;"))
			        VAR _SafePct = SUBSTITUTE(FORMAT(_ChangePct, "+0.0%;-0.0%;0.0%"), "%", "%25")
			        VAR _LabelX = IF(_IsPositive, _AxisX + _BarWidth + 10, _AxisX - _BarWidth - 10)
			        VAR _Anchor = IF(_IsPositive, "start", "end")
			
			        RETURN
			            "<g transform='translate(0, " & (_HeaderHeight + (COUNTROWS(FILTER(_Devices, [New users] > _Actual)) * _RowHeight)) & ")'>" &
			                // Device Name
			                "<text x='20' y='25' font-family='Segoe UI, sans-serif' font-size='13' font-weight='600' fill='" & _TextDark & "'>" & _SafeDevice & "</text>" &
			                // Absolute Value
			                "<text x='20' y='40' font-family='Segoe UI, sans-serif' font-size='11' fill='" & _TextMuted & "'>" & FORMAT(_Actual, "#,0") & " users</text>" &
			                
			                // Diverging Bar
			                "<rect x='" & _BarX & "' y='15' width='" & _BarWidth & "' height='16' fill='" & _BarColor & "' rx='2'/>" &
			                
			                // Variance Label
			                "<text x='" & _LabelX & "' y='27' font-family='Segoe UI, sans-serif' font-size='11' font-weight='700' fill='" & _BarColor & "' text-anchor='" & _Anchor & "'>" & _SafePct & "</text>" &
			            "</g>",
			        "",
			        [New users], DESC
			    )
			
			// Build Full SVG
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%25' height='100%25' viewBox='0 0 " & _Width & " " & _Height & "'>" &
			        "<rect width='100%25' height='100%25' fill='" & _BgColor & "' rx='12'/>" &
			        
			        // Header
			        "<text x='20' y='35' font-family='Segoe UI, sans-serif' font-size='16' font-weight='700' fill='" & _TextDark & "'>Device Momentum</text>" &
			        "<text x='20' y='52' font-family='Segoe UI, sans-serif' font-size='12' fill='" & _TextMuted & "'>Change in new users vs previous period</text>" &
			        
			        // Divider
			        "<line x1='20' y1='60' x2='418' y2='60' stroke='%23E5E7EB' stroke-width='1'/>" &
			        
			        // Center Axis Line
			        "<line x1='219' y1='70' x2='219' y2='350' stroke='" & _AxisColor & "' stroke-width='2' stroke-dasharray='4 4'/>" &
			        
			        // Rows
			        _RowsHTML &
			    "</svg>"
			
			RETURN 
			    "data:image/svg+xml;utf8," & _SVG
			```
		lineageTag: 7d6a0ede-f7bf-450f-b309-2cde587d9f61

	/// Display name of the selected KPI.
	measure 'KPI Name' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, "Total users",
			    1, "New users",
			    2, "Ecommerce purchases",
			    3, "ECVR",
			    4, "Purchase revenue",
			    "KPI"
			)
		displayFolder: HTML cards
		lineageTag: 84a587eb-1abf-42ef-9357-59f778848253

	/// Signed number format of the selected KPI (for change labels).
	measure 'KPI Signed Format' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    3, "+0.00;-0.00;0.00",
			    4, "+$#,0;-$#,0;$0",
			    "+#,0;-#,0;0"
			)
		displayFolder: HTML cards
		lineageTag: 160ac8d9-147f-44c3-a64f-ae0b3da66fb4

	/// ECVR changes are shown in percentage points, so they are multiplied by 100.
	measure 'KPI Signed Multiplier' = IF ( SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ) = 3, 100, 1 )
		formatString: 0
		displayFolder: HTML cards
		lineageTag: 2374a9fc-7bcd-42d8-85d6-7d73c7ae4835

	/// Unit suffix of change labels (' pp' for ECVR).
	measure 'KPI Signed Suffix' = IF ( SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ) = 3, " pp", "" )
		displayFolder: HTML cards
		lineageTag: 49f7b0bd-9cea-4598-b3a8-20c022d0f129

	/// Engaged sessions / sessions.
	measure 'Engagement rate' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_sessions ), fact_sessions[is_engaged] = TRUE () ),
			    [Sessions]
			)
		formatString: 0.0%
		displayFolder: HTML cards
		lineageTag: 445516d3-e7e7-4537-8ff6-623e1b4add46

	/// Purchase revenue / total users.
	measure 'Revenue per user' = DIVIDE ( [Purchase revenue], [Total users] )
		formatString: \$#,0.00
		displayFolder: HTML cards
		lineageTag: 101547f7-6f84-476b-982f-98fe3b7ba58e

	/// Share of all selected sessions that come from the source in the row (sums to 100%).
	measure 'Sessions Share' =
			DIVIDE (
			    [Sessions],
			    CALCULATE ( [Sessions], ALLSELECTED ( dim_traffic_source ) )
			)
		formatString: 0.0%
		displayFolder: HTML cards
		lineageTag: b08af5f4-a6e3-4e24-a98e-b528e480c748

	/// Row template for the 'What changed' card (one row per source).
	measure 'HTML Movers Row' =
			-- ROW template for the "What changed" card: one row per traffic source.
			-- Visual fields: Context = dim_traffic_source[traffic_source], Values = this measure.
			-- Sort the visual by THIS measure, descending (the HTML comment carries the sort key).
			VAR _topN  = 5
			VAR _avail = [KPI Comparison Available]
			VAR _src   = SELECTEDVALUE ( dim_traffic_source[traffic_source], "(not set)" )
			VAR _srcHtml = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _src, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
			VAR _chg    = [KPI Value] - COALESCE ( [KPI Comparison], 0 )
			VAR _abs    = ABS ( _chg )
			VAR _maxAbs =
			    MAXX (
			        ALLSELECTED ( dim_traffic_source[traffic_source] ),
			        ABS ( [KPI Value] - COALESCE ( [KPI Comparison], 0 ) )
			    )
			VAR _rank =
			    RANKX (
			        ALLSELECTED ( dim_traffic_source[traffic_source] ),
			        ABS ( [KPI Value] - COALESCE ( [KPI Comparison], 0 ) ),
			        ,
			        DESC,
			        DENSE
			    )
			VAR _half  = DIVIDE ( _abs, _maxAbs ) * 50
			VAR _up    = _chg >= 0
			VAR _cls   = IF ( _up, "up", "down" )
			VAR _left  = IF ( _up, 50, 50 - _half )
			VAR _chgText = FORMAT ( _chg * [KPI Signed Multiplier], [KPI Signed Format] ) & [KPI Signed Suffix]
			VAR _pct     = [KPI Delta]
			VAR _pctText = IF ( ISBLANK ( _pct ), "new", FORMAT ( _pct, "+0%;-0%;0%" ) )
			VAR _sortKey = FORMAT ( ROUND ( DIVIDE ( _abs, _maxAbs ) * 1000000, 0 ), "0000000" )
			RETURN
			    IF (
			        _avail && _abs > 0 && _rank <= _topN,
			        "<!--" & _sortKey & "-->"
			            & "<div class='mv'>"
			            & "<div class='mv-name' title='" & _srcHtml & "'>" & _srcHtml & "</div>"
			            & "<div class='mv-bar'><span class='mv-axis'></span>"
			            & "<span class='mv-fill " & _cls & "' style='left:" & _left & "%;width:" & _half & "%'></span></div>"
			            & "<div class='mv-val " & _cls & "'>" & _chgText & "</div>"
			            & "<div class='mv-pct'>" & _pctText & "</div>"
			            & "</div>"
			    )
		displayFolder: HTML cards
		lineageTag: 0b98dbe7-198c-4990-af55-b1c84cbb110e

	/// Body template for the 'What changed' card (contains {{content}}).
	measure 'HTML Movers Body' =
			-- BODY template for the "What changed" card. Bind it to the visual's Body template (fx > Field value).
			-- Contains the {{content}} placeholder where the visual inserts the rows.
			VAR _name  = [KPI Name]
			VAR _avail = [KPI Comparison Available]
			VAR _pct   = [KPI Delta]
			VAR _chg   = [KPI Value] - COALESCE ( [KPI Comparison], 0 )
			VAR _up    = _chg >= 0
			VAR _cls   = IF ( _up, "up", "down" )
			VAR _arrow = IF ( _up, "&#9650;", "&#9660;" )
			VAR _chgText = FORMAT ( _chg * [KPI Signed Multiplier], [KPI Signed Format] ) & [KPI Signed Suffix]
			
			-- Biggest drag and biggest lift across sources
			VAR _t =
			    ADDCOLUMNS (
			        ALLSELECTED ( dim_traffic_source[traffic_source] ),
			        "@chg", [KPI Value] - COALESCE ( [KPI Comparison], 0 )
			    )
			VAR _drag = TOPN ( 1, FILTER ( _t, [@chg] < 0 ), [@chg], ASC )
			VAR _lift = TOPN ( 1, FILTER ( _t, [@chg] > 0 ), [@chg], DESC )
			VAR _dragName = MAXX ( _drag, dim_traffic_source[traffic_source] )
			VAR _liftName = MAXX ( _lift, dim_traffic_source[traffic_source] )
			VAR _dragNameH = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _dragName, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
			VAR _liftNameH = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _liftName, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "'", "&#39;" )
			VAR _dragText = FORMAT ( MAXX ( _drag, [@chg] ) * [KPI Signed Multiplier], [KPI Signed Format] ) & [KPI Signed Suffix]
			VAR _liftText = FORMAT ( MAXX ( _lift, [@chg] ) * [KPI Signed Multiplier], [KPI Signed Format] ) & [KPI Signed Suffix]
			
			VAR _hero =
			    IF (
			        _avail && NOT ISBLANK ( _pct ),
			        "<div class='hero'><span class='hero-pct " & _cls & "'>" & _arrow & " " & FORMAT ( ABS ( _pct ), "0.0%" )
			            & "</span><span class='hero-abs'>" & _chgText & " " & _name & "</span></div>",
			        "<div class='hero'><span class='hero-na'>No comparison available for this range</span></div>"
			    )
			VAR _story =
			    IF (
			        NOT _avail,
			        "The previous period starts before your first day of data, so there is nothing to compare with.",
			        IF ( ISBLANK ( _dragName ), "No source declined. ", "Biggest drag: <b>" & _dragNameH & "</b> (" & _dragText & "). " )
			            & IF ( ISBLANK ( _liftName ), "No source grew.", "Biggest lift: <b>" & _liftNameH & "</b> (" & _liftText & ")." )
			    )
			
			RETURN
			    "<div class='card'>"
			        & "<div class='card-head'><div class='card-title'>What changed</div>"
			        & "<div class='card-sub'>" & _name & " &middot; " & [Period Range Label] & "</div></div>"
			        & _hero
			        & "<div class='story'>" & _story & "</div>"
			        & "<div class='mv-head'><span>Source</span><span>Change vs previous period</span><span>Change</span><span>%</span></div>"
			        & "<div class='mv-list'>{{content}}</div>"
			        & "<div class='card-foot'>Compared with " & [Comparison Range Label] & " &middot; top 5 sources by absolute change</div>"
			        & "</div>"
		displayFolder: HTML cards
		lineageTag: ca5d3415-7f5b-45b2-bf23-ba403bca3020

	/// Stylesheet for the 'What changed' card.
	measure 'HTML Movers CSS' =
			"
			#htmlContent {
			  --primary: #0057CE;
			  --secondary: #D51A9F;
			  --ink: #041225;
			  --muted: #64778F;
			  --line: #E5E7EB;
			  --track: #E6EDF8;
			  --soft: #F3F6FA;
			  font-family: 'Segoe UI', Arial, sans-serif;
			  color: var(--ink);
			  width: 100%;
			  height: 100%;
			  box-sizing: border-box;
			  padding: 6px 8px;
			  overflow: hidden;
			}
			.card { display: flex; flex-direction: column; height: 100%; gap: 8px; }
			.card-title { font-size: 15px; font-weight: 600; }
			.card-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
			.card-foot { margin-top: auto; font-size: 10px; color: var(--muted); }
			.htmlViewerEntry { margin: 0; padding: 0; }
			.htmlViewerEntry:empty { display: none; }
			.hero { display: flex; align-items: baseline; gap: 10px; }
			.hero-pct { font-size: 30px; font-weight: 700; line-height: 1; }
			.hero-pct.up { color: var(--primary); }
			.hero-pct.down { color: var(--secondary); }
			.hero-abs { font-size: 12px; color: var(--muted); }
			.hero-na { font-size: 13px; color: var(--muted); }
			.story { font-size: 12px; line-height: 1.45; background: var(--soft); border-left: 3px solid var(--primary); padding: 8px 10px; border-radius: 6px; }
			.mv-head, .mv { display: grid; grid-template-columns: 1.25fr 1.5fr 0.8fr 0.55fr; column-gap: 8px; align-items: center; }
			.mv-head { font-size: 10px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); padding: 0 2px 4px; border-bottom: 1px solid var(--line); }
			.mv-head span:nth-child(3), .mv-head span:nth-child(4), .mv-val, .mv-pct { text-align: right; }
			.mv { height: 32px; font-size: 12px; border-bottom: 1px solid #F0F2F6; padding: 0 2px; }
			.mv-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.mv-bar { position: relative; height: 12px; }
			.mv-axis { position: absolute; left: 50%; top: -4px; bottom: -4px; width: 1px; background: var(--muted); }
			.mv-fill { position: absolute; top: 1px; bottom: 1px; border-radius: 3px; }
			.mv-fill.up { background: var(--primary); }
			.mv-fill.down { background: var(--secondary); }
			.mv-val { font-weight: 600; font-variant-numeric: tabular-nums; }
			.mv-val.up { color: var(--primary); }
			.mv-val.down { color: var(--secondary); }
			.mv-pct { color: var(--muted); font-variant-numeric: tabular-nums; }
			"
		displayFolder: HTML cards
		lineageTag: b5c7ff43-1c0b-4e54-a743-56e365611ca0

	/// Row template for the 'Channel quality' card (one list row per source).
	measure 'HTML Quality Row' = ```
			-- ROW template for the "Channel quality" card: one list row per traffic source.
			
			VAR _src =
			    SELECTEDVALUE (
			        dim_traffic_source[traffic_source],
			        "(not set)"
			    )
			
			VAR _srcHtml =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE (
			                SUBSTITUTE ( _src, "&", "&amp;" ),
			                "<", "&lt;"
			            ),
			            ">", "&gt;"
			        ),
			        "'", "&#39;"
			    )
			
			VAR _sessions = [Sessions]
			VAR _rank = [Quality Rank]
			VAR _verdict = [Quality Verdict]
			VAR _share = [Sessions Share]
			VAR _eng = [Engagement rate]
			VAR _ecvr = COALESCE ( [ECVR], 0 )
			VAR _rpu = COALESCE ( [Revenue per user], 0 )
			
			VAR _bench =
			    CALCULATE ( [ECVR], ALLSELECTED ( dim_traffic_source ) )
			
			VAR _cls =
			    SWITCH (
			        _verdict,
			        "Scale", "scale",
			        "Fix funnel", "fix",
			        "Hidden gem", "gem",
			        "mute"
			    )
			
			VAR _ecvrCls =
			    IF ( _ecvr >= _bench, "up", "down" )
			
			VAR _shareText =
			    IF (
			        _share < 0.005,
			        "&lt;1%",
			        FORMAT ( _share, "0%" )
			    )
			
			VAR _sortKey =
			    FORMAT ( _sessions, "0000000000" )
			
			RETURN
			    IF (
			        _sessions > 0 && _rank <= [Quality Top N],
			        "<!--" & _sortKey & "-->"
			            & "<div class='q'>"
			
			                & "<div class='q-rank " & _cls & "'>"
			                    & _rank
			                & "</div>"
			
			                & "<div class='q-main'>"
			                    & "<div class='q-name' title='" & _srcHtml & "'>"
			                        & _srcHtml
			                    & "</div>"
			                    & "<div class='q-sub'>"
			                        & _shareText & " of sessions"
			                    & "</div>"
			                & "</div>"
			
			                & "<div class='q-num'>"
			                    & FORMAT ( _eng, "0%" )
			                & "</div>"
			
			                & "<div class='q-num " & _ecvrCls & "'>"
			                    & FORMAT ( _ecvr, "0.00%" )
			                & "</div>"
			
			                & "<div class='q-num'>"
			                    & FORMAT ( _rpu, "$#,0.00" )
			                & "</div>"
			
			                & "<div class='q-verdict'>"
			                    & "<span class='pill " & _cls & "'>"
			                        & _verdict
			                    & "</span>"
			                & "</div>"
			
			            & "</div>"
			    )
			
			```
		displayFolder: HTML cards
		lineageTag: df8cac4d-b36c-4727-a061-14e72458a6d6

	/// Body template for the 'Channel quality' card (plot, summary, header, {{content}}, legend).
	measure 'HTML Quality Body' = ```
			
			
			VAR _topN = [Quality Top N]
			
			VAR _src =
			    FILTER (
			        ALLSELECTED ( dim_traffic_source[traffic_source] ),
			        [Sessions] > 0
			    )
			
			VAR _pts =
			    ADDCOLUMNS (
			        _src,
			        "@rank", [Quality Rank],
			        "@share", [Sessions Share],
			        "@ecvr", COALESCE ( [ECVR], 0 ),
			        "@verdict", [Quality Verdict]
			    )
			
			VAR _active = COUNTROWS ( _pts )
			
			VAR _bench =
			    CALCULATE ( [ECVR], ALLSELECTED ( dim_traffic_source ) )
			
			VAR _equal =
			    DIVIDE ( 1, _active )
			
			VAR _xMax =
			    MAX ( 0.01, MAXX ( _pts, [@share] ) * 1.15 )
			
			VAR _yMax =
			    MAX ( 0.001, MAXX ( _pts, [@ecvr] ) * 1.15 )
			
			VAR _vx =
			    MIN ( 100, DIVIDE ( _equal, _xMax ) * 100 )
			
			VAR _hy =
			    MIN ( 100, DIVIDE ( _bench, _yMax ) * 100 )
			
			// Scatter plot markers
			VAR _dots =
			    CONCATENATEX (
			        FILTER ( _pts, [@rank] <= _topN ),
			
			        VAR _x =
			            ROUND ( DIVIDE ( [@share], _xMax ) * 100, 1 )
			
			        VAR _y =
			            ROUND ( DIVIDE ( [@ecvr], _yMax ) * 100, 1 )
			
			        VAR _cls =
			            SWITCH (
			                [@verdict],
			                "Scale", "scale",
			                "Fix funnel", "fix",
			                "Hidden gem", "gem",
			                "mute"
			            )
			
			        VAR _name =
			            SUBSTITUTE (
			                SUBSTITUTE (
			                    SUBSTITUTE (
			                        SUBSTITUTE (
			                            dim_traffic_source[traffic_source],
			                            "&", "&amp;"
			                        ),
			                        "<", "&lt;"
			                    ),
			                    ">", "&gt;"
			                ),
			                "'", "&#39;"
			            )
			
			        RETURN
			            "<div class='dot " & _cls
			                & "' style='left:" & _x
			                & "%;bottom:" & _y
			                & "%' title='#" & [@rank] & " " & _name
			                & " - " & FORMAT ( [@share], "0%" )
			                & " of sessions, ECVR "
			                & FORMAT ( [@ecvr], "0.00%" )
			                & "'>"
			                & [@rank]
			                & "</div>",
			
			        "",
			        [@rank], ASC
			    )
			
			// Information popover
			VAR _info =
			    "<details class='info' data-hc-suppress='all'>"
			
			        & "<summary title='About channel quality' aria-label='About channel quality'>"
			            & "<span aria-hidden='true'>i</span>"
			        & "</summary>"
			
			        & "<div class='info-panel'>"
			
			            & "<div class='info-title'>How to read this visual</div>"
			
			            & "<div class='info-item'>"
			                & "<b class='scale-text'>Scale</b>"
			                & " &mdash; High share, above-average conversion."
			            & "</div>"
			
			            & "<div class='info-item'>"
			                & "<b class='fix-text'>Fix funnel</b>"
			                & " &mdash; High share, below-average conversion."
			            & "</div>"
			
			            & "<div class='info-item'>"
			                & "<b class='gem-text'>Hidden gem</b>"
			                & " &mdash; Low share, above-average conversion."
			            & "</div>"
			
			            & "<div class='info-item'>"
			                & "<b class='mute-text'>Monitor</b>"
			                & " &mdash; Low share, below-average conversion."
			            & "</div>"
			
			            & "<div class='info-note'>"
			                & "Dashed lines represent equal share ("
			                & FORMAT ( _equal, "0%" )
			                & ") and the all-sources ECVR benchmark ("
			                & FORMAT ( _bench, "0.00%" )
			                & "). Under "
			                & FORMAT ( [Quality Min Sessions], "#,0" )
			                & " sessions, a source is shown as Low data."
			            & "</div>"
			
			        & "</div>"
			
			    & "</details>"
			
			RETURN
			    "<div class='card'>"
			
			        // Header
			        & "<div class='card-head'>"
			
			            & "<div class='card-title'>"
			                & "Channel quality"
			            & "</div>"
			
			            & "<div class='card-sub'>"
			                & "Do the sources that bring volume also bring buyers?"
			                & " &middot; "
			                & [Period Range Label]
			            & "</div>"
			
			            & _info
			
			        & "</div>"
			
			        // Scatter plot
			        & "<div class='plot-wrap'>"
			
			            & "<div class='ax-y'>"
			                & "ECVR (0&ndash;"
			                & FORMAT ( _yMax, "0.0%" )
			                & ") &rarr;"
			            & "</div>"
			
			            & "<div class='plot'>"
			
			                & "<div class='thr-v' style='left:"
			                    & ROUND ( _vx, 1 ) & "%'></div>"
			
			                & "<div class='thr-h' style='bottom:"
			                    & ROUND ( _hy, 1 ) & "%'></div>"
			
			                & "<span class='quad tl'>Hidden gem</span>"
			                & "<span class='quad tr'>Scale</span>"
			                & "<span class='quad bl'>Monitor</span>"
			                & "<span class='quad br'>Fix funnel</span>"
			
			                & _dots
			
			            & "</div>"
			
			            & "<div class='ax-x'>"
			                & "Share of sessions (0&ndash;"
			                & FORMAT ( _xMax, "0%" )
			                & ") &rarr;"
			            & "</div>"
			
			        & "</div>"
			
			        // Table header
			        & "<div class='q-head'>"
			
			            & "<span></span>"
			            & "<span>Source</span>"
			            & "<span>Engaged</span>"
			            & "<span>ECVR</span>"
			            & "<span>$ / user</span>"
			            & "<span>Verdict</span>"
			
			        & "</div>"
			
			        // Individual traffic source rows
			        & "<div class='q-list'>"
			            & "{{content}}"
			        & "</div>"
			
			    & "</div>"
			
			```
		displayFolder: HTML cards
		lineageTag: c6ead2da-b658-428a-b563-6aca68432e4a

	/// Stylesheet for the 'Channel quality' card (560 x 756 px).
	measure 'HTML Quality CSS' =
			"
			#htmlContent {
			  --primary: #0057CE;
			  --secondary: #D51A9F;
			  --ink: #041225;
			  --muted: #64778F;
			  --line: #E5E7EB;
			  --pos-fill: #EAF2FF;
			  --neg-fill: #FCEAF5;
			  font-family: 'Segoe UI', Arial, sans-serif;
			  font-size: 13px;
			  color: var(--ink);
			  background: #FFFFFF;
			  width: 100%;
			  height: 100%;
			  box-sizing: border-box;
			  padding: 12px 16px;
			  overflow: hidden;
			}
			.card { display: flex; flex-direction: column; height: 100%; gap: 8px; }
			.card-title { font-size: 15px; font-weight: 600; }
			.card-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
			.htmlViewerEntry { margin: 0; padding: 0; }
			.htmlViewerEntry:empty { display: none; }
			
			/* volume vs conversion plot */
			.plot-wrap { position: relative; height: 250px; flex: 0 0 250px; }
			.plot { position: absolute; left: 34px; right: 8px; top: 6px; bottom: 26px; border-left: 1px solid #CBD5E1; border-bottom: 1px solid #CBD5E1; }
			.thr-v { position: absolute; top: 0; bottom: 0; border-left: 1px dashed #B9C4D6; }
			.thr-h { position: absolute; left: 0; right: 0; border-top: 1px dashed #B9C4D6; }
			.quad { position: absolute; font-size: 11px; font-weight: 600; color: var(--muted); opacity: .75; }
			.quad.tl { top: 6px; left: 8px; }
			.quad.tr { top: 6px; right: 8px; }
			.quad.bl { bottom: 6px; left: 8px; }
			.quad.br { bottom: 6px; right: 8px; }
			.ax-x { position: absolute; left: 34px; right: 8px; bottom: 2px; text-align: center; font-size: 11px; color: var(--muted); }
			.ax-y { position: absolute; left: 4px; top: 6px; bottom: 26px; width: 16px; writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; font-size: 11px; color: var(--muted); }
			.dot { position: absolute; width: 26px; height: 26px; margin: 0 0 -13px -13px; border-radius: 50%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; background: #FFFFFF; }
			.dot.scale { background: var(--primary); color: #FFFFFF; }
			.dot.fix { background: var(--secondary); color: #FFFFFF; }
			.dot.gem { border: 1.5px solid var(--primary); color: var(--primary); }
			.dot.mute { border: 1.5px solid var(--muted); color: var(--muted); }
			
			/* benchmark line */
			.summary { font-size: 12px; color: var(--muted); padding: 2px 0 6px; border-bottom: 1px solid var(--line); }
			.summary b { color: var(--ink); font-weight: 600; }
			
			/* list */
			.q-head, .q { display: grid; grid-template-columns: 26px minmax(0, 1fr) 54px 58px 54px 92px; column-gap: 10px; align-items: center; }
			.q-head { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); padding: 0 2px; }
			.q-head span:nth-child(n+3):nth-child(-n+5) { text-align: right; }
			.q-head span:nth-child(6) { text-align: right; }
			.q { min-height: 44px; padding: 4px 2px; border-bottom: 1px solid #F0F2F6; }
			.q-rank { width: 24px; height: 24px; border-radius: 50%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; background: #FFFFFF; }
			.q-rank.scale { background: var(--primary); color: #FFFFFF; }
			.q-rank.fix { background: var(--secondary); color: #FFFFFF; }
			.q-rank.gem { border: 1.5px solid var(--primary); color: var(--primary); }
			.q-rank.mute { border: 1.5px solid var(--muted); color: var(--muted); }
			.q-name { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.q-sub { font-size: 12px; color: var(--muted); margin-top: 1px; }
			.q-num { text-align: right; font-size: 14px; font-variant-numeric: tabular-nums; }
			.q-num.up { color: var(--primary); font-weight: 600; }
			.q-num.down { color: var(--secondary); font-weight: 600; }
			.q-verdict { text-align: right; }
			
			/* verdict pills: only the verdicts that call for action stand out */
			.pill { display: inline-block; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
			.pill.scale { background: var(--pos-fill); color: var(--primary); }
			.pill.fix { background: var(--neg-fill); color: var(--secondary); }
			.pill.gem { background: #FFFFFF; color: var(--primary); border: 1px solid var(--primary); padding: 2px 9px; }
			.pill.mute { background: transparent; color: var(--muted); font-weight: 400; padding: 3px 0; }
			
			/* legend */
			.legend { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; font-size: 11.5px; color: var(--muted); padding-top: 8px; border-top: 1px solid var(--line); }
			.legend .pill { font-size: 11px; padding: 1px 8px; margin-right: 6px; }
			.legend .pill.gem { padding: 0 7px; }
			.legend .pill.mute { padding: 1px 0; margin-right: 6px; }
			.lg-note { grid-column: 1 / -1; font-size: 11px; }
			"
		displayFolder: HTML cards
		lineageTag: 3f63b951-35f1-4520-8cb8-f2bf59a0ade1

	/// How many sources the Channel quality card shows (list and plot).
	measure 'Quality Top N' = 6
		formatString: 0
		displayFolder: HTML cards
		lineageTag: 2290ffdb-f9a3-4756-896d-7bd2247d119d

	/// Below this many sessions a source gets the 'Low data' verdict instead of a judgement.
	measure 'Quality Min Sessions' = 100
		formatString: 0
		displayFolder: HTML cards
		lineageTag: 57b08339-6b51-47b1-8829-7c5e1b8a384c

	/// Rank of the source in the row by sessions (1 = biggest). Used for the numbered markers and list.
	measure 'Quality Rank' =
			IF (
			    [Sessions] > 0,
			    RANKX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [Sessions], , DESC, DENSE )
			)
		formatString: 0
		displayFolder: HTML cards
		lineageTag: bdd29a6a-2dde-4447-96a4-b6652648febd

	/// Scale / Fix funnel / Hidden gem / Monitor / Low data. 'Big' = share of sessions >= equal share of the active sources; 'converts' = ECVR >= all-sources ECVR.
	measure 'Quality Verdict' =
			VAR _sessions = [Sessions]
			VAR _share    = [Sessions Share]
			VAR _ecvr     = COALESCE ( [ECVR], 0 )
			VAR _bench    = CALCULATE ( [ECVR], ALLSELECTED ( dim_traffic_source ) )
			VAR _active   = COUNTROWS ( FILTER ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [Sessions] > 0 ) )
			VAR _isBig    = _share >= DIVIDE ( 1, _active )
			VAR _converts = _ecvr >= _bench
			RETURN
			    IF (
			        ISBLANK ( _sessions ), BLANK (),
			        IF (
			            _sessions < [Quality Min Sessions], "Low data",
			            IF (
			                _isBig,
			                IF ( _converts, "Scale", "Fix funnel" ),
			                IF ( _converts, "Hidden gem", "Monitor" )
			            )
			        )
			    )
		displayFolder: HTML cards
		lineageTag: 1a28b28e-6196-49bc-bb95-b128076887b3

	measure '@@ SIMPLE BI User Acquisition Tour' =
			
			VAR _cssBase =
			"<style>
			html,body{margin:0;padding:0;overflow:hidden;background:transparent}
			:root{--sbi-blue:#0057CE;--sbi-ink:#041225;--sbi-muted:#64778F;--sbi-surface:#FFFFFF;--sbi-positive:#EAF2FF;--sbi-magenta:#D51A9F;--sbi-negative:#FCEAF5;--sbi-line:#D9E2F2;--sbi-veil:rgba(255,255,255,1);--sbi-glow:rgba(0,87,206,.38)}
			.sbi-tour{position:fixed;left:0;top:0;width:1920px;height:1080px;overflow:hidden;background:transparent;font-family:'Segoe UI',Arial,sans-serif;color:var(--sbi-ink);pointer-events:none;isolation:isolate}
			.sbi-tour *{box-sizing:border-box}
			.sbi-tour .tour-root{display:block;position:static;margin:0;padding:0}
			.sbi-tour .tour-blocker{position:absolute;inset:0;z-index:10;background:transparent;pointer-events:none}
			.sbi-tour .tour-root[open]+.tour-blocker{pointer-events:auto}
			.sbi-tour summary{list-style:none;cursor:pointer}
			.sbi-tour summary::marker{content:''}
			.sbi-tour summary::-webkit-details-marker{display:none}
			.sbi-tour summary:focus-visible{outline:3px solid var(--sbi-magenta);outline-offset:3px}
			.sbi-tour .tour-exit{position:absolute;left:1650px;top:24px;z-index:999;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-width:164px;padding:11px 16px;border:1px solid #D9E2F2;border-radius:999px;background:#FFFFFF;color:var(--sbi-blue);font-size:14px;font-weight:700;box-shadow:0 3px 14px rgba(4,18,37,.08);white-space:nowrap;pointer-events:auto;transition:all .18s ease}
			.sbi-tour .tour-root:not([open])>.tour-exit{display:none}
			.sbi-tour .tour-exit:hover{border-color:var(--sbi-magenta);background:var(--sbi-negative);color:var(--sbi-magenta);transform:translateY(-1px)}
			.sbi-tour .spot{position:absolute;border-radius:12px;background:transparent;box-shadow:0 0 26px 6px var(--sbi-glow),0 0 0 2400px var(--sbi-veil);outline:2px solid var(--sbi-blue);outline-offset:5px;pointer-events:none;animation:spot-show .45s ease-out both}
			.sbi-tour .spot::after{content:'';position:absolute;inset:-5px;border:2px solid var(--sbi-blue);border-radius:14px;animation:spot-ring 1.9s ease-out infinite;pointer-events:none}
			.sbi-tour .spot::before{content:'';position:absolute;inset:-12px;pointer-events:none;background:
			linear-gradient(var(--sbi-magenta),var(--sbi-magenta)) left top/24px 4px no-repeat,
			linear-gradient(var(--sbi-magenta),var(--sbi-magenta)) left top/4px 24px no-repeat,
			linear-gradient(var(--sbi-magenta),var(--sbi-magenta)) right top/24px 4px no-repeat,
			linear-gradient(var(--sbi-magenta),var(--sbi-magenta)) right top/4px 24px no-repeat,
			linear-gradient(var(--sbi-magenta),var(--sbi-magenta)) left bottom/24px 4px no-repeat,
			linear-gradient(var(--sbi-magenta),var(--sbi-magenta)) left bottom/4px 24px no-repeat,
			linear-gradient(var(--sbi-magenta),var(--sbi-magenta)) right bottom/24px 4px no-repeat,
			linear-gradient(var(--sbi-magenta),var(--sbi-magenta)) right bottom/4px 24px no-repeat;animation:reticle 2.2s ease-in-out infinite}
			.sbi-tour .spot-1{left:294px;top:141px;width:1574px;height:134px;z-index:100}
			.sbi-tour .spot-2{left:294px;top:285px;width:1082px;height:359px;z-index:200}
			.sbi-tour .spot-3{left:301px;top:674px;width:1082px;height:367px;z-index:300}
			.sbi-tour .spot-4{left:1417px;top:285px;width:462px;height:756px;z-index:400}
			@keyframes spot-show{from{opacity:.25}to{opacity:1}}
			@keyframes spot-ring{0%{inset:-5px;opacity:.55}100%{inset:-20px;opacity:0}}
			@keyframes reticle{0%,100%{inset:-12px}50%{inset:-18px}}
			</style>"
			VAR _cssCards =
			"<style>
			.sbi-tour .tip{position:absolute;width:500px;padding:25px 28px 65px;background:var(--sbi-surface);border:1px solid var(--sbi-line);border-radius:14px;box-shadow:0 18px 44px rgba(4,18,37,.16);overflow:hidden;animation:tip-enter .5s .12s cubic-bezier(.2,1.25,.35,1) both}
			.sbi-tour .tip::before{content:'';position:absolute;left:0;right:0;top:0;height:5px;background:linear-gradient(90deg,var(--sbi-blue),var(--sbi-magenta))}
			.sbi-tour .tip-1{left:630px;top:445px;width:520px;z-index:101}
			.sbi-tour .tip-2{left:1417px;top:455px;width:462px;z-index:201}
			.sbi-tour .tip-3{left:650px;top:280px;width:520px;z-index:301}
			.sbi-tour .tip-4{left:865px;top:430px;width:515px;z-index:401}
			@keyframes tip-enter{from{opacity:0;transform:translateY(18px) scale(.97)}to{opacity:1;transform:none}}
			.sbi-tour .tag{display:flex;align-items:center;gap:12px;margin:0 0 10px;height:22px;white-space:nowrap}
			.sbi-tour .tag .num{display:inline-flex;align-items:center;justify-content:center;height:22px;min-width:34px;padding:0 11px;border-radius:999px;background:linear-gradient(135deg,var(--sbi-magenta),var(--sbi-blue));color:#FFFFFF;font-size:12px;font-weight:800;letter-spacing:.06em;box-shadow:0 3px 10px rgba(213,26,159,.3)}
			.sbi-tour .tag .label{font-size:14px;font-weight:800;color:var(--sbi-blue);letter-spacing:.09em;text-transform:uppercase}
			.sbi-tour .tip h2{margin:0 0 18px;color:var(--sbi-ink);font-size:29px;line-height:1.16;font-weight:750;letter-spacing:-.45px}
			.sbi-tour .tip p{margin:0 0 15px;color:#26384D;font-size:16px;line-height:1.52}
			.sbi-tour .tip p b{color:var(--sbi-ink);font-weight:700}
			.sbi-tour .chip{display:inline-block;border-radius:5px;padding:1px 8px;font-size:13px;font-weight:700;white-space:nowrap}
			.sbi-tour .chip.up{background:var(--sbi-positive);color:var(--sbi-blue)}
			.sbi-tour .chip.down{background:var(--sbi-negative);color:var(--sbi-magenta)}
			.sbi-tour .foot{display:flex;align-items:center;justify-content:space-between;margin-top:22px;min-height:17px}
			.sbi-tour .progress{display:flex;align-items:center;gap:7px}
			.sbi-tour .pip{width:9px;height:9px;border-radius:6px;background:#E1E8F4;display:inline-block}
			.sbi-tour .pip.done{background:#8FB4F0}
			.sbi-tour .pip.on{width:30px;background:linear-gradient(90deg,var(--sbi-blue),var(--sbi-magenta));box-shadow:0 0 10px rgba(0,87,206,.45)}
			.sbi-tour .count{margin-left:7px;color:var(--sbi-muted);font-size:12px;font-weight:700;white-space:nowrap}
			</style>"
			VAR _cssButtons =
			"<style>
			.sbi-tour .step-toggle{position:absolute;display:inline-flex;align-items:center;justify-content:center;min-width:112px;height:42px;padding:0 20px;border:0;border-radius:10px;background:linear-gradient(135deg,#0A63E0,var(--sbi-blue));color:#FFFFFF;font-size:15px;font-weight:700;white-space:nowrap;pointer-events:auto;box-shadow:0 6px 18px rgba(0,87,206,.35);animation:btn-pulse 1.8s ease-in-out infinite;transition:transform .15s ease}
			.sbi-tour .step-toggle:hover{transform:translateY(-2px)}
			.sbi-tour .step-toggle .next i{display:inline-block;font-style:normal;margin-left:7px;animation:nudge 1.1s ease-in-out infinite}
			.sbi-tour .step-toggle .back{display:none}
			.sbi-tour .step[open]>.step-toggle{background:#FFFFFF;color:var(--sbi-blue);border:1px solid var(--sbi-line);box-shadow:0 4px 14px rgba(4,18,37,.08);animation:none}
			.sbi-tour .step[open]>.step-toggle:hover{border-color:var(--sbi-blue)}
			.sbi-tour .step[open]>.step-toggle .next{display:none}
			.sbi-tour .step[open]>.step-toggle .back{display:inline}
			@keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(5px)}}
			@keyframes btn-pulse{0%,100%{box-shadow:0 6px 18px rgba(0,87,206,.35),0 0 0 0 rgba(0,87,206,.45)}60%{box-shadow:0 6px 18px rgba(0,87,206,.35),0 0 0 12px rgba(0,87,206,0)}}
			
			/* --- FIXED BUTTON POSITIONS (Moved down by 10px) --- */
			.sbi-tour .step-2:not([open])>.step-toggle{left:1010px;top:685px;z-index:102}
			.sbi-tour .step-2[open]>.step-toggle{left:1620px;top:705px;z-index:202}
			.sbi-tour .step-3:not([open])>.step-toggle{left:1740px;top:705px;z-index:302}
			.sbi-tour .step-3[open]>.step-toggle{left:870px;top:530px;z-index:302}
			.sbi-tour .step-4:not([open])>.step-toggle{left:990px;top:530px;z-index:402}
			.sbi-tour .step-4[open]>.step-toggle{left:1250px;top:680px;z-index:402}
			
			.sbi-tour .step-2[open]:has(.step-3[open])>.step-toggle{display:none}
			.sbi-tour .step-3[open]:has(.step-4[open])>.step-toggle{display:none}
			.sbi-tour .step-2[open]~.spot-1,.sbi-tour .step-2[open]~.tip-1,.sbi-tour .step-2[open]~.arrow-1{display:none}
			.sbi-tour .step-3[open]~.spot-2,.sbi-tour .step-3[open]~.tip-2,.sbi-tour .step-3[open]~.arrow-2{display:none}
			.sbi-tour .step-4[open]~.spot-3,.sbi-tour .step-4[open]~.tip-3,.sbi-tour .step-4[open]~.arrow-3{display:none}
			.sbi-tour .arrow{position:absolute;overflow:visible;fill:none;pointer-events:none;filter:drop-shadow(0 4px 6px rgba(0,87,206,.22))}
			.sbi-tour .arrow-glow{fill:none;stroke:var(--sbi-blue);stroke-width:10;stroke-linecap:round;opacity:.14}
			.sbi-tour .arrow-base{fill:none;stroke-width:2.5;stroke-linecap:round;opacity:.55}
			.sbi-tour .arrow-flow{fill:none;stroke-width:3.5;stroke-linecap:round;stroke-dasharray:6 14;animation:flow .9s linear infinite}
			.sbi-tour .arrow-head{fill:var(--sbi-magenta);stroke:#FFFFFF;stroke-width:1;stroke-linejoin:round}
			.sbi-tour .arrow .origin{fill:var(--sbi-blue);opacity:.8}
			.sbi-tour .arrow .tgt{fill:var(--sbi-magenta)}
			.sbi-tour .arrow .ping{fill:var(--sbi-magenta)}
			@keyframes flow{from{stroke-dashoffset:20}to{stroke-dashoffset:0}}
			.sbi-tour .arrow-1{left:920px;top:230px;width:220px;height:220px;z-index:103}
			.sbi-tour .arrow-2{left:1220px;top:350px;width:205px;height:170px;z-index:203}
			.sbi-tour .arrow-3{left:1130px;top:420px;width:205px;height:300px;z-index:303}
			.sbi-tour .arrow-4{left:1245px;top:365px;width:245px;height:150px;z-index:403}
			@media (prefers-reduced-motion:reduce){.sbi-tour .spot,.sbi-tour .spot::after,.sbi-tour .spot::before,.sbi-tour .tip,.sbi-tour .step-toggle,.sbi-tour .step-toggle .next i,.sbi-tour .arrow-flow{animation:none}}
			</style>"
			VAR _html =
			"<div class='sbi-tour' role='group' aria-label='SIMPLE BI interactive dashboard tour'>
			<details class='tour-root' open>
			<summary class='tour-exit' aria-label='End dashboard tour'><span>End tour &times;</span></summary>
			<div class='tour-body'>
			
			<!-- STEP 1 toggle -> opens step 2 -->
			<details class='step step-2'>
			<summary class='step-toggle'><span class='next'>Next<i>&rarr;</i></span><span class='back'>&larr; Back</span></summary>
			<div class='step-body'>
			
			<!-- STEP 2 toggle -> opens step 3 -->
			<details class='step step-3'>
			<summary class='step-toggle'><span class='next'>Next<i>&rarr;</i></span><span class='back'>&larr; Back</span></summary>
			<div class='step-body'>
			
			<!-- STEP 3 toggle -> opens step 4 -->
			<details class='step step-4'>
			<summary class='step-toggle'><span class='next'>Next<i>&rarr;</i></span><span class='back'>&larr; Back</span></summary>
			<div class='step-body'>
			<div class='spot spot-4'></div>
			<article class='tip tip-4'>
			<div class='tag'><span class='num'>03</span><span class='label'>Engagement / Conversion</span></div>
			<h2>What is the quality of those users?</h2>
			<p>This section helps compare traffic sources beyond volume. Use engagement and conversion signals to distinguish sources that bring many visits from those that bring visitors who interact or purchase.</p>
			<div class='foot'><div class='progress'><span class='pip done'></span><span class='pip done'></span><span class='pip done'></span><span class='pip on'></span><span class='count'>4 / 4</span></div></div>
			</article>
			<svg class='arrow arrow-4' viewBox='0 0 245 150' aria-hidden='true'>
			<defs><linearGradient id='ag4' gradientUnits='userSpaceOnUse' x1='130' y1='100' x2='235' y2='25'><stop offset='0' stop-color='#0057CE'/><stop offset='1' stop-color='#D51A9F'/></linearGradient></defs>
			<path class='arrow-glow' d='M130 100 C160 85 200 55 235 25'/>
			<path class='arrow-base' stroke='url(#ag4)' d='M130 100 C160 85 200 55 235 25'/>
			<path class='arrow-flow' stroke='url(#ag4)' d='M130 100 C160 85 200 55 235 25'/>
			<circle class='origin' cx='130' cy='100' r='4'/>
			<circle class='tgt' cx='235' cy='25' r='5'/>
			<circle class='ping' cx='235' cy='25' r='5'><animate attributeName='r' values='5;20' dur='1.6s' repeatCount='indefinite'/><animate attributeName='opacity' values='.55;0' dur='1.6s' repeatCount='indefinite'/></circle>
			<path class='arrow-head' d='M-12 -8 L3 0 L-12 8 Z'><animateMotion dur='1.8s' repeatCount='indefinite' rotate='auto' path='M130 100 C160 85 200 55 235 25'/></path>
			<path class='arrow-head' d='M-12 -8 L3 0 L-12 8 Z'><animateMotion dur='1.8s' begin='-0.9s' repeatCount='indefinite' rotate='auto' path='M130 100 C160 85 200 55 235 25'/></path>
			</svg>
			</div>
			</details>
			
			<div class='spot spot-3'></div>
			<article class='tip tip-3'>
			<div class='tag'><span class='num'>02</span><span class='label'>Volume</span></div>
			<h2>Where are my users coming from?</h2>
			<p>The table breaks results down by traffic source. Compare current and previous-period values to spot the sources contributing most to your volume and where performance is improving or declining.</p>
			<div class='foot'><div class='progress'><span class='pip done'></span><span class='pip done'></span><span class='pip on'></span><span class='pip'></span><span class='count'>3 / 4</span></div></div>
			</article>
			<svg class='arrow arrow-3' viewBox='0 0 205 300' aria-hidden='true'>
			<defs><linearGradient id='ag3' gradientUnits='userSpaceOnUse' x1='45' y1='20' x2='155' y2='270'><stop offset='0' stop-color='#0057CE'/><stop offset='1' stop-color='#D51A9F'/></linearGradient></defs>
			<path class='arrow-glow' d='M45 20 C75 90 125 190 155 270'/>
			<path class='arrow-base' stroke='url(#ag3)' d='M45 20 C75 90 125 190 155 270'/>
			<path class='arrow-flow' stroke='url(#ag3)' d='M45 20 C75 90 125 190 155 270'/>
			<circle class='origin' cx='45' cy='20' r='4'/>
			<circle class='tgt' cx='155' cy='270' r='5'/>
			<circle class='ping' cx='155' cy='270' r='5'><animate attributeName='r' values='5;20' dur='1.6s' repeatCount='indefinite'/><animate attributeName='opacity' values='.55;0' dur='1.6s' repeatCount='indefinite'/></circle>
			<path class='arrow-head' d='M-12 -8 L3 0 L-12 8 Z'><animateMotion dur='1.8s' repeatCount='indefinite' rotate='auto' path='M45 20 C75 90 125 190 155 270'/></path>
			<path class='arrow-head' d='M-12 -8 L3 0 L-12 8 Z'><animateMotion dur='1.8s' begin='-0.9s' repeatCount='indefinite' rotate='auto' path='M45 20 C75 90 125 190 155 270'/></path>
			</svg>
			</div>
			</details>
			
			<div class='spot spot-2'></div>
			<article class='tip tip-2'>
			<div class='tag'><span class='num'>01</span><span class='label'>Momentum / Growth</span></div>
			<h2>How is the trend changing?</h2>
