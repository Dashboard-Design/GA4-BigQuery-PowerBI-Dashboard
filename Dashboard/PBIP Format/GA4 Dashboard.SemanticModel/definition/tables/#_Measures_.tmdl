	measure 'KPI Card SVG Selected' =
			
			VAR _KPIOrder =
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] )
			
			-- Configuration
			VAR _W = 180
			VAR _H = 100
			
			-- Calculations
			VAR _KPIName =
			    SWITCH (
			        _KPIOrder,
			        0, "Total users",
			        1, "New users",
			        2, "Ecommerce purchases",
			        3, "ECVR",
			        4, "Purchase revenue",
			        "KPI"
			    )
			
			VAR _KPIValue = [KPI Value]
			VAR _KPIDelta = [KPI Delta]
			
			VAR _FormattedValue =
			    SWITCH (
			        _KPIOrder,
			        0, FORMAT ( _KPIValue, "#,##0" ),
			        1, FORMAT ( _KPIValue, "#,##0" ),
			        2, FORMAT ( _KPIValue, "#,##0" ),
			        3, FORMAT ( _KPIValue, "0.00%" ),
			        4, FORMAT ( _KPIValue, "$#,##0,.0K" ),
			        FORMAT ( _KPIValue, "#,##0.##" )
			    )
			
			VAR _FormattedValueEncoded =
			    SUBSTITUTE (
			        SUBSTITUTE ( _FormattedValue, "%", "%25" ),
			        "+", "%2B"
			    )
			
			VAR _FormattedDelta =
			    FORMAT ( _KPIDelta, "+0.0%;-0.0%;0.0%" )
			
			VAR _DeltaRaw =
			    IF (
			        ISBLANK ( _KPIDelta ),
			        "N/A",
			        _FormattedDelta
			    )
			
			VAR _DeltaTextEncoded =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE ( _DeltaRaw, "%", "%25" ),
			            "+", "%2B"
			        ),
			        " ", "%20"
			    )
			
			-- Colors
			VAR _LabelColor = "%230057CE" -- Selected blue
			VAR _ValueColor = "%23041225" -- Dark navy
			VAR _AccentBlue = "%230057CE" -- Selection underline
			VAR _CardBackground = "%23FFFFFF" -- White
			
			VAR _DeltaColor =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _KPIDelta ), "%2364778F",
			        _KPIDelta > 0, "%230057CE",
			        _KPIDelta < 0, "%23D51A9F",
			        "%2364778F"
			    )
			
			VAR _DeltaFill =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _KPIDelta ), "%23F3F6FA",
			        _KPIDelta > 0, "%23EAF2FF",
			        _KPIDelta < 0, "%23FCEAF5",
			        "%23F3F6FA"
			    )
			
			VAR _DeltaArrow =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _KPIDelta ), "",
			        _KPIDelta > 0, "&%239650;",
			        _KPIDelta < 0, "&%239660;",
			        ""
			    )
			
			VAR _DeltaDisplay =
			    IF (
			        ISBLANK ( _KPIDelta ),
			        "N/A",
			        IF (
			            _DeltaArrow <> "",
			            _DeltaArrow & "%20" & _DeltaTextEncoded,
			            _DeltaTextEncoded
			        )
			    )
			
			-- Geometry: adapt typography and positioning to the value
			VAR _ValueFontSize =
			    SWITCH (
			        TRUE (),
			        LEN ( _FormattedValue ) >= 13, 13,
			        LEN ( _FormattedValue ) >= 10, 18,
			        LEN ( _FormattedValue ) >= 8, 20,
			        24
			    )
			
			VAR _EstimatedValueWidth =
			    LEN ( _FormattedValue ) * _ValueFontSize * 0.64
			
			VAR _DeltaX =
			    12 + _EstimatedValueWidth + 4
			
			VAR _DeltaXText =
			    FORMAT ( _DeltaX, "0" )
			
			VAR _DeltaCenterX =
			    FORMAT ( _DeltaX + 34, "0" )
			
			-- SVG
			VAR _SVG =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%25' height='100%25' viewBox='-2 -2 184 104' overflow='visible' display='block'>"
			        & "<rect x='1' y='1' width='178' height='98' rx='7' fill='" & _CardBackground & "'/>"
			        & "<text x='12' y='26' font-family='Segoe UI,Arial,sans-serif' font-size='14' font-weight='600' fill='" & _LabelColor & "'>"
			        & _KPIName
			        & "</text>"
			        & "<text x='12' y='63' font-family='Segoe UI,Arial,sans-serif' font-size='" & FORMAT ( _ValueFontSize, "0" ) & "' font-weight='700' fill='" & _ValueColor & "'>"
			        & _FormattedValueEncoded
			        & "</text>"
			        & "<rect x='" & _DeltaXText & "' y='43' width='68' height='22' rx='5' fill='" & _DeltaFill & "'/>"
			        & "<text x='" & _DeltaCenterX & "' y='58' text-anchor='middle' font-family='Segoe UI,Arial,sans-serif' font-size='11' font-weight='600' fill='" & _DeltaColor & "'>"
			        & _DeltaDisplay
			        & "</text>"
			        & "<rect x='20' y='81' width='140' height='3' rx='1.5' fill='" & _AccentBlue & "'/>"
			        & "</svg>"
			
			RETURN
			    IF (
			        HASONEVALUE ( 'KPI Selector'[KPI Selector Order] ),
			        "data:image/svg+xml;charset=utf-8," & _SVG,
			        BLANK ()
			    )
		lineageTag: 783d68be-2a47-4298-8011-21b750c1b32e
		dataCategory: ImageUrl

	measure 'KPI Comparison' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, [Total users (Comparison)],
			    1, [New users (Comparison)],
			    2, [Ecommerce purchases (Comparison)],
			    3, [ECVR (Comparison)],
			    4, [Purchase revenue (Comparison)]
			)
		displayFolder: Period comparison\Selected KPI table
		lineageTag: 558e9455-a387-4f5c-bd26-b4bdd05546b8

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
				    3, "0.00%",
				    4, "\$#,0",
				    "#,0"
				)

	measure 'KPI Share of Total' =
			IF (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ) = 3,
			    BLANK (),    -- a rate (ECVR) has no meaningful share of total
			    DIVIDE (
			        [KPI Value],
			        CALCULATE ( [KPI Value], ALLSELECTED ( dim_traffic_source ) )
			    )
			)
		formatString: 0.0%
		displayFolder: Period comparison\Selected KPI table
		lineageTag: c44d6e94-ec22-429b-8f99-36de70beb261

	measure 'KPI Target Bar' =
			-- Same logic as UDF_TargetLineBarChart, inlined as a regular measure.
			-- Bar = selected KPI for the selected period; dashed line = comparison period.
			
			-- Colors (# encoded as %23 so the data URI stays valid)
			VAR _AboveColor  = "%230057CE"   -- primary:   at/above comparison
			VAR _BelowColor  = "%23D51A9F"   -- secondary: below comparison
			VAR _TrackColor  = "%23E6EDF8"   -- light tint of primary
			VAR _TargetColor = "%23041225"   -- main text color
			
			-- Geometry
			VAR _ChartHeight = 35
			VAR _BarHeight   = 28
			VAR _AxisMin     = 0
			VAR _AxisMax     = 130
			
			-- Values
			VAR _Actual      = [KPI Value]
			VAR _Target      = [KPI Comparison]
			VAR _HasTarget   = NOT ISBLANK ( _Target )
			VAR _Performance = DIVIDE ( _Actual - _Target, _Target )
			VAR _Range       = _AxisMax - _AxisMin
			
			-- Common scale across all traffic sources shown
			VAR _MaxActual =
			    CALCULATE (
			        MAXX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [KPI Value] ),
			        REMOVEFILTERS ( dim_traffic_source[traffic_source] )
			    )
			VAR _MaxTarget =
			    CALCULATE (
			        MAXX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [KPI Comparison] ),
			        REMOVEFILTERS ( dim_traffic_source[traffic_source] )
			    )
			VAR _GlobalMax = MAX ( _MaxActual, _MaxTarget ) * 1.15
			
			VAR _ActualWidth = MAX ( 0, DIVIDE ( _Actual, _GlobalMax ) * _Range )
			VAR _TargetPos   = _AxisMin + DIVIDE ( _Target, _GlobalMax ) * _Range
			VAR _BarColor    = IF ( _HasTarget && _Performance < 0, _BelowColor, _AboveColor )
			VAR _BarY        = ( _ChartHeight - _BarHeight ) / 2
			
			VAR _SVG =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100%25' height='100%25' viewBox='0 0 "
			        & _AxisMax & " " & _ChartHeight & "' preserveAspectRatio='none'>"
			    & "<rect x='" & _AxisMin & "' y='" & _BarY & "' width='" & _Range & "' height='" & _BarHeight
			        & "' fill='" & _TrackColor & "' rx='4' ry='4'/>"
			    & "<rect x='" & _AxisMin & "' y='" & _BarY & "' width='" & _ActualWidth & "' height='" & _BarHeight
			        & "' fill='" & _BarColor & "' rx='4' ry='4'/>"
			    & IF (
			        _HasTarget,
			        "<line x1='" & _TargetPos & "' y1='0' x2='" & _TargetPos & "' y2='" & _ChartHeight
			            & "' stroke='" & _TargetColor & "' stroke-width='2' stroke-dasharray='4 2'/>",
			        ""
			    )
			    & "</svg>"
			
			RETURN
			    IF (
			        HASONEVALUE ( dim_traffic_source[traffic_source] ) && NOT ISBLANK ( _Actual ),
			        _SVG
			    )
		displayFolder: Period comparison\Selected KPI table
		lineageTag: b02f9b23-c0ca-4d7c-a223-f8f1c2ec60d4
		dataCategory: ImageUrl

	measure 'KPI Table Title' =
			"Acquisition by traffic source – " & SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, "Total users",
			    1, "New users",
			    2, "Ecommerce purchases",
			    3, "ECVR",
			    4, "Purchase revenue",
			    "KPIs"
			)
		displayFolder: Period comparison\Selected KPI table
		lineageTag: 10a9bc79-44a7-4ede-918e-3a004b479a07

	measure 'KPI Table Subtitle' = [Period Range Label] & "  " & [Comparison Caption] & "  (" & [Comparison Range Label] & ")"
		displayFolder: Period comparison\Selected KPI table
		lineageTag: 75152273-45a2-4c77-9b49-02d50c10c1a6

	/// Value for the selected KPI in the configured comparison period.
	measure 'KPI Comparison Value' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, [Total users (Comparison)],
			    1, [New users (Comparison)],
			    2, [Ecommerce purchases (Comparison)],
			    3, [ECVR (Comparison)],
			    4, [Purchase revenue (Comparison)]
			)
		displayFolder: User Acquisition\KPI Selector
		lineageTag: e15cdd6a-f775-4436-8e05-28f60ac9b59d

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
				    3, "0.00%",
				    4, "\$#,0",
				    "#,0"
				)

	/// SVG bar: selected-period KPI in blue with comparison-period target marker in magenta.
	measure 'KPI Target Line Bar SVG' =
			VAR _Actual = [KPI Value]
			VAR _Target = [KPI Comparison Value]
			VAR _MaxActual =
			    CALCULATE (
			        MAXX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [KPI Value] ),
			        REMOVEFILTERS ( dim_traffic_source[traffic_source] )
			    )
			VAR _MaxTarget =
			    CALCULATE (
			        MAXX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [KPI Comparison Value] ),
			        REMOVEFILTERS ( dim_traffic_source[traffic_source] )
			    )
			VAR _ScaleMax = MAX ( _MaxActual, _MaxTarget )
			VAR _ChartWidth = 180
			VAR _ChartHeight = 34
			VAR _BarWidth = MAX ( 0, DIVIDE ( _Actual, _ScaleMax, 0 ) * _ChartWidth )
			VAR _TargetX = MIN ( _ChartWidth, MAX ( 0, DIVIDE ( _Target, _ScaleMax, 0 ) * _ChartWidth ) )
			VAR _TargetLine =
			    IF (
			        NOT ISBLANK ( _Target ),
			        "<line x1='" & FORMAT ( _TargetX, "0.0" ) & "' y1='3' x2='" & FORMAT ( _TargetX, "0.0" ) & "' y2='31' stroke='%23D51A9F' stroke-width='3'/>",
			        ""
			    )
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%25' height='100%25' viewBox='0 0 180 34' preserveAspectRatio='none'>"
			        & "<rect x='0' y='7' width='180' height='20' rx='3' fill='%23041225' fill-opacity='0.08'/>"
			        & "<rect x='0' y='7' width='" & FORMAT ( _BarWidth, "0.0" ) & "' height='20' rx='3' fill='%230057CE'/>"
			        & _TargetLine
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _Actual ), "data:image/svg+xml;utf8," & _Svg )
		formatString: @
		displayFolder: User Acquisition\KPI Selector
		lineageTag: 3ef7d35f-d496-44b9-9616-ea6eb5e7c2c9
		dataCategory: ImageUrl

	/// First day with data in the model (ignores all filters).
	measure 'First Data Date' = CALCULATE ( MIN ( fact_events[date_key] ), REMOVEFILTERS () )
		formatString: d mmm yyyy
		displayFolder: Period comparison\Helpers
		lineageTag: 75b1208c-ac14-4804-b36b-aeaf40604ec7

	/// TRUE when the previous period lies fully inside the loaded data, so comparison visuals can be trusted.
	measure 'KPI Comparison Available' = [Comparison Start] >= [First Data Date]
		displayFolder: IBCS table
		lineageTag: dfa01a4b-bd87-4cc0-bca6-5d6d9df40954

	/// Number format of the selected KPI, used to format SVG labels.
	measure 'KPI Format String' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    3, "0.00%",
			    4, "$#,0",
			    "#,0"
			)
		displayFolder: IBCS table
		lineageTag: b349dd27-d4b4-464f-a5af-5e6947d31342

	/// Formatted current value of the selected KPI, safe to embed in an SVG data URI (% encoded).
	measure 'KPI Label Current' = SUBSTITUTE ( FORMAT ( [KPI Value], [KPI Format String] ), "%", "%25" )
		displayFolder: IBCS table
		lineageTag: aa49d84e-3490-48b3-9965-a8c9d4f0c513

	/// Absolute change vs the previous period, formatted per KPI (ECVR in percentage points).
	measure 'KPI Label Delta' =
			VAR _delta = [KPI Value] - COALESCE ( [KPI Comparison], 0 )
			RETURN
			    SWITCH (
			        SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			        3, FORMAT ( _delta * 100, "+0.00;-0.00;0.00" ) & " pp",
			        4, FORMAT ( _delta, "+$#,0;-$#,0;$0" ),
			        FORMAT ( _delta, "+#,0;-#,0;0" )
			    )
		displayFolder: IBCS table
		lineageTag: 5aead036-b5f5-48d2-ad11-dde8040d7e91

	/// IBCS bar: selected KPI, current period (blue) over previous period (grey). Set data category to Image URL.
	measure 'KPI IBCS Bar' =
			-- IBCS bar: selected KPI for the selected period (blue bar) over the previous period (grey bar).
			-- Adapted from PowerofBI.IBCS.BarChart.AbsoluteValues (MIT licence, Andrzej Leszkiewicz).
			-- Set the table column's Cell elements > Image width / height to _W x _H below.
			
			-- Layout
			VAR _W = 240
			VAR _H = 30
			VAR _Em = _H * 0.6
			VAR _LabelPad = _Em * 0.3
			
			-- Colors (# encoded as %23 so the data URI stays valid)
			VAR _ColorCurrent  = "%230057CE"   -- primary
			VAR _ColorPrevious = "%23B9C4D6"   -- muted slate tint
			VAR _ColorText     = "%23041225"   -- main text
			VAR _ColorAxis     = "%2364778F"   -- muted slate
			
			-- Values
			VAR _Actual  = [KPI Value]
			VAR _HasBase = [KPI Comparison Available]
			VAR _Base    = IF ( _HasBase, COALESCE ( [KPI Comparison], 0 ) )
			VAR _IsRow   = ISINSCOPE ( dim_traffic_source[traffic_source] )
			VAR _ValueMax =
			    MAXX (
			        ALLSELECTED ( dim_traffic_source[traffic_source] ),
			        MAX ( [KPI Value], [KPI Comparison] )
			    )
			VAR _Scale     = DIVIDE ( _W * 0.76, _ValueMax )
			VAR _WidthCur  = ROUND ( _Actual * _Scale, 0 )
			VAR _WidthPrev = ROUND ( _Base * _Scale, 0 )
			VAR _LabelX    = MAX ( _WidthCur, _WidthPrev ) + _LabelPad
			VAR _Label     = [KPI Label Current]
			-- Sort key embedded in the SVG so the column can be sorted
			VAR _Rank = 1000000000000 + ROUND ( DIVIDE ( _Actual, _ValueMax ) * 1000000, 0 )
			
			-- SVG
			VAR _Open =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W & "' height='" & _H & "'>"
			VAR _Style =
			    "<style>text{font-family:'Segoe UI',sans-serif;font-size:" & _Em & "px;dominant-baseline:central;}</style>"
			VAR _Previous =
			    IF (
			        _HasBase,
			        "<rect x='0' y='0.5' width='" & _WidthPrev & "' height='" & _Em & "' fill='" & _ColorPrevious & "'/>",
			        ""
			    )
			VAR _Current =
			    "<rect x='0' y='" & ( _H - _Em ) / 2 & "' width='" & _WidthCur & "' height='" & _Em & "' fill='" & _ColorCurrent & "'/>"
			VAR _Axis =
			    "<line x1='0.5' x2='0.5' y1='0' y2='" & _H & "' stroke='" & _ColorAxis & "' stroke-width='1'/>"
			VAR _Text =
			    "<text x='" & _LabelX & "' y='" & _H / 2 & "' fill='" & _ColorText & "'>" & _Label & "</text>"
			VAR _TextTotal =
			    "<text x='2' y='" & _H / 2 & "' fill='" & _ColorText & "' font-weight='bold'>" & _Label & "</text>"
			VAR _SvgRow   = _Open & _Style & "/*SortBy:" & _Rank & "*/" & _Previous & _Current & _Axis & _Text & "</svg>"
			VAR _SvgTotal = _Open & _Style & _TextTotal & "</svg>"
			
			RETURN
			    IF ( ISBLANK ( _Actual ), BLANK (), IF ( _IsRow, _SvgRow, _SvgTotal ) )
		displayFolder: IBCS table
		lineageTag: f8727bd3-e35b-4ba1-a4a3-cf0551180097
		dataCategory: ImageUrl

	/// IBCS variance bar: absolute change vs the previous period, diverging from a centre axis.
	measure 'KPI IBCS Variance' =
			-- IBCS variance bar: absolute change vs the previous period, diverging from a centre axis.
			-- Blue = increase, magenta = decrease (your palette; all five KPIs are "higher is better").
			-- Adapted from PowerofBI.IBCS.BarChart.AbsoluteVariance (MIT licence, Andrzej Leszkiewicz).
			-- Scaled to the largest change in the table so small changes stay readable.
			
			-- Layout
			VAR _W = 240
			VAR _H = 30
			VAR _Em = _H * 0.6
			VAR _LabelPad = _Em * 0.3
			
			-- Colors (# encoded as %23 so the data URI stays valid)
			VAR _ColorUp   = "%230057CE"   -- primary
			VAR _ColorDown = "%23D51A9F"   -- secondary
			VAR _ColorText = "%23041225"   -- main text
			VAR _ColorAxis = "%2364778F"   -- muted slate
			
			-- Values
			VAR _Available = [KPI Comparison Available]
			VAR _Actual    = [KPI Value]
			VAR _Var       = _Actual - COALESCE ( [KPI Comparison], 0 )
			VAR _IsRow     = ISINSCOPE ( dim_traffic_source[traffic_source] )
			VAR _MaxAbs =
			    MAXX (
			        ALLSELECTED ( dim_traffic_source[traffic_source] ),
			        ABS ( [KPI Value] - COALESCE ( [KPI Comparison], 0 ) )
			    )
			VAR _AxisX  = _W / 2
			VAR _Scale  = DIVIDE ( _W * 0.36, _MaxAbs )
			VAR _Width  = ROUND ( ABS ( _Var ) * _Scale, 0 )
			VAR _Up     = _Var >= 0
			VAR _X      = IF ( _Up, _AxisX, _AxisX - _Width )
			VAR _Color  = IF ( _Up, _ColorUp, _ColorDown )
			VAR _Anchor = IF ( _Up, "start", "end" )
			VAR _LabelX = IF ( _Up, _AxisX + _Width + _LabelPad, _AxisX - _Width - _LabelPad )
			VAR _Label  = [KPI Label Delta]
			VAR _Rank   = 1000000000000 + ROUND ( DIVIDE ( _Var + _MaxAbs, 2 * _MaxAbs ) * 1000000, 0 )
			
			-- SVG
			VAR _Open =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W & "' height='" & _H & "'>"
			VAR _Style =
			    "<style>text{font-family:'Segoe UI',sans-serif;font-size:" & _Em & "px;dominant-baseline:central;}</style>"
			VAR _AxisLine =
			    "<line x1='" & _AxisX & "' x2='" & _AxisX & "' y1='0' y2='" & _H & "' stroke='" & _ColorAxis & "' stroke-width='1'/>"
			VAR _Bar =
			    "<rect x='" & _X & "' y='" & ( _H - _Em ) / 2 & "' width='" & _Width & "' height='" & _Em & "' fill='" & _Color & "'/>"
			VAR _Text =
			    "<text x='" & _LabelX & "' y='" & _H / 2 & "' fill='" & _ColorText & "' text-anchor='" & _Anchor & "'>" & _Label & "</text>"
			VAR _TextTotal =
			    "<text x='" & _AxisX & "' y='" & _H / 2 & "' fill='" & _ColorText & "' text-anchor='middle' font-weight='bold'>" & _Label & "</text>"
			VAR _SvgRow   = _Open & _Style & "/*SortBy:" & _Rank & "*/" & _AxisLine & _Bar & _Text & "</svg>"
			VAR _SvgTotal = _Open & _Style & _TextTotal & "</svg>"
			
			RETURN
			    IF (
			        NOT _Available || ISBLANK ( _Actual ),
			        BLANK (),
			        IF ( _IsRow, _SvgRow, _SvgTotal )
			    )
		displayFolder: IBCS table
		lineageTag: fb00df68-b817-4213-ac35-22fb64548f97
		dataCategory: ImageUrl

	/// IBCS pin chart: relative change (%) vs the previous period, capped at +/-100%.
	measure 'KPI IBCS Pin' =
			-- IBCS pin chart: relative change (%) vs the previous period. Pins are capped at +/-100%;
			-- larger changes show a triangle, and a source with no previous value shows "NEW".
			-- Adapted from PowerofBI.IBCS.BarChart.RelativeVariance (MIT licence, Andrzej Leszkiewicz).
			
			-- Layout
			VAR _W = 240
			VAR _H = 30
			VAR _Em = _H * 0.6
			VAR _LabelPad = _Em * 0.3
			VAR _HeadW = _Em * 0.5
			VAR _HeadH = _Em * 0.9
			
			-- Colors (# encoded as %23 so the data URI stays valid)
			VAR _ColorUp   = "%230057CE"   -- primary
			VAR _ColorDown = "%23D51A9F"   -- secondary
			VAR _ColorText = "%23041225"   -- main text
			VAR _ColorAxis = "%23C9D3E3"   -- light slate
			
			-- Values
			VAR _Available = [KPI Comparison Available]
			VAR _Actual    = [KPI Value]
			VAR _Base      = COALESCE ( [KPI Comparison], 0 )
			VAR _IsRow     = ISINSCOPE ( dim_traffic_source[traffic_source] )
			VAR _IsNew     = _Actual > 0 && _Base = 0
			VAR _NoData    = NOT _Available || ISBLANK ( _Actual ) || ( _Actual = 0 && _Base = 0 )
			VAR _Pct       = IF ( _Base = 0, BLANK (), ROUND ( DIVIDE ( _Actual - _Base, _Base ) * 100, 0 ) )
			VAR _PctCapped = SIGN ( _Pct ) * MIN ( 100, ABS ( _Pct ) )
			VAR _IsOutlier = ABS ( _Pct ) > 100
			VAR _AxisX     = _W / 2
			VAR _Width     = ROUND ( ABS ( _PctCapped ) / 100 * _W * 0.30, 0 )
			VAR _Up        = _Pct >= 0
			VAR _Tip       = IF ( _Up, _AxisX + _Width, _AxisX - _Width )
			VAR _X         = IF ( _Up, _AxisX, _AxisX - _Width )
			VAR _Color     = IF ( _Up, _ColorUp, _ColorDown )
			VAR _Span      = IF ( _IsOutlier, _Em * 0.9, _HeadW / 2 )
			VAR _Label     = IF ( _IsNew, "NEW", FORMAT ( _Pct, "+0;-0;0" ) & "%25" )
			VAR _LabelX    = IF ( _IsNew, _AxisX + _LabelPad, IF ( _Up, _Tip + _Span + _LabelPad, _Tip - _Span - _LabelPad ) )
			VAR _Anchor    = IF ( _IsNew || _Up, "start", "end" )
			VAR _Rank      = 1000000000000 + ROUND ( MAX ( -1000, MIN ( 1000, COALESCE ( _Pct, 1000 ) ) ) + 1000, 0 )
			
			-- SVG
			VAR _Open =
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W & "' height='" & _H & "'>"
			VAR _Style =
			    "<style>text{font-family:'Segoe UI',sans-serif;font-size:" & _Em & "px;dominant-baseline:central;}</style>"
			VAR _AxisLine =
			    "<line x1='" & _AxisX & "' x2='" & _AxisX & "' y1='0' y2='" & _H & "' stroke='" & _ColorAxis & "' stroke-width='2'/>"
			VAR _PinBar =
			    IF (
			        _IsNew || ISBLANK ( _Pct ),
			        "",
			        "<rect x='" & _X & "' y='" & _H / 2 - _Em * 0.12 & "' width='" & _Width & "' height='" & _Em * 0.24 & "' fill='" & _Color & "'/>"
			    )
			VAR _PinHead =
			    IF (
			        _IsNew || ISBLANK ( _Pct ),
			        "",
			        IF (
			            _IsOutlier,
			            "<text x='" & _Tip & "' y='" & _H / 2 & "' fill='" & _Color & "' text-anchor='" & IF ( _Up, "start", "end" ) & "'>"
			                & IF ( _Up, UNICHAR ( 9656 ), UNICHAR ( 9666 ) ) & "</text>",
			            "<rect x='" & _Tip - _HeadW / 2 & "' y='" & ( _H - _HeadH ) / 2 & "' width='" & _HeadW & "' height='" & _HeadH & "' fill='" & _ColorText & "'/>"
			        )
			    )
			VAR _Text =
			    "<text x='" & _LabelX & "' y='" & _H / 2 & "' fill='" & _ColorText & "' text-anchor='" & _Anchor & "'>" & _Label & "</text>"
			VAR _TextTotal =
			    "<text x='" & _AxisX & "' y='" & _H / 2 & "' fill='" & _ColorText & "' text-anchor='middle' font-weight='bold'>" & _Label & "</text>"
			VAR _SvgRow   = _Open & _Style & "/*SortBy:" & _Rank & "*/" & _AxisLine & _PinBar & _PinHead & _Text & "</svg>"
			VAR _SvgTotal = _Open & _Style & _TextTotal & "</svg>"
			
			RETURN
			    IF ( _NoData, BLANK (), IF ( _IsRow, _SvgRow, _SvgTotal ) )
		displayFolder: IBCS table
		lineageTag: 159a5364-cd74-411b-8d84-f90c39723f47
		dataCategory: ImageUrl

	partition #_Measures_ = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

