	/// Value for the selected KPI in the configured comparison period.
	measure 'KPI Comparison Value' =
			SWITCH (
			    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
			    0, [Total users (Comparison)],
			    1, [New users (Comparison)],
			    2, [Ecommerce purchases (Comparison)],
			    3, [ECVR (Comparison)],
			    4, [Purchase revenue (Comparison)]
			)
		displayFolder: User Acquisition\KPI Selector
		lineageTag: e15cdd6a-f775-4436-8e05-28f60ac9b59d

		formatStringDefinition =
				SWITCH (
				    SELECTEDVALUE ( 'KPI Selector'[KPI Selector Order] ),
				    3, "0.00%",
				    4, "\$#,0",
				    "#,0"
				)

	/// SVG bar: selected-period KPI in blue with comparison-period target marker in magenta.
	measure 'KPI Target Line Bar SVG' =
			VAR _Actual = [KPI Value]
			VAR _Target = [KPI Comparison Value]
			VAR _MaxActual =
			    CALCULATE (
			        MAXX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [KPI Value] ),
			        REMOVEFILTERS ( dim_traffic_source[traffic_source] )
			    )
			VAR _MaxTarget =
			    CALCULATE (
			        MAXX ( ALLSELECTED ( dim_traffic_source[traffic_source] ), [KPI Comparison Value] ),
			        REMOVEFILTERS ( dim_traffic_source[traffic_source] )
			    )
			VAR _ScaleMax = MAX ( _MaxActual, _MaxTarget )
			VAR _ChartWidth = 180
			VAR _ChartHeight = 34
			VAR _BarWidth = MAX ( 0, DIVIDE ( _Actual, _ScaleMax, 0 ) * _ChartWidth )
			VAR _TargetX = MIN ( _ChartWidth, MAX ( 0, DIVIDE ( _Target, _ScaleMax, 0 ) * _ChartWidth ) )
			VAR _TargetLine =
			    IF (
			        NOT ISBLANK ( _Target ),
			        "<line x1='" & FORMAT ( _TargetX, "0.0" ) & "' y1='3' x2='" & FORMAT ( _TargetX, "0.0" ) & "' y2='31' stroke='%23D51A9F' stroke-width='3'/>",
			        ""
			    )
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%25' height='100%25' viewBox='0 0 180 34' preserveAspectRatio='none'>"
			        & "<rect x='0' y='7' width='180' height='20' rx='3' fill='%23041225' fill-opacity='0.08'/>"
			        & "<rect x='0' y='7' width='" & FORMAT ( _BarWidth, "0.0" ) & "' height='20' rx='3' fill='%230057CE'/>"
			        & _TargetLine
			        & "</svg>"
			RETURN
			    IF ( NOT ISBLANK ( _Actual ), "data:image/svg+xml;utf8," & _Svg )
		formatString: @
		displayFolder: User Acquisition\KPI Selector
		lineageTag: 3ef7d35f-d496-44b9-9616-ea6eb5e7c2c9
		dataCategory: ImageUrl

	/// First day with data in the model (ignores all filters).
	measure 'First Data Date' = CALCULATE ( MIN ( fact_events[date_key] ), REMOVEFILTERS () )
		formatString: d mmm yyyy
		displayFolder: Period comparison\Helpers
		lineageTag: 75b1208c-ac14-4804-b36b-aeaf40604ec7

	partition #_Measures_ = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

